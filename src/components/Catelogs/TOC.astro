---
import type { MarkdownHeading } from "astro";

const { headings } = Astro.props;
---

<article>
    {headings && headings.length > 0 && 
        (
            <nav class="toc">
                <ul>
                    {headings.map((h: MarkdownHeading) => 
                    (
                        <li style={`padding-left: ${(h.depth - 1) * 0.8}rem;`}>
                            <a href={`#${h.slug}`}>{h.text}</a>
                        </li>
                    ))};
                </ul>
            </nav>
        )};
</article>

<style>
    html 
    {
        scroll-behavior: smooth;
        scroll-padding-top: 25vh;
    }

    .toc ul
    {
        list-style: none;
        padding-left: 0;
    }

    .toc a {
        color: #cccccc;          /* 改文字颜色，浅灰 */
        text-decoration: none;   /* 去掉下划线 */
        font-size: 0.9rem;
        transition: color 0.2s;
    }
    .toc a:hover {
        color: #ffffff;          /* 鼠标悬停变白 */
    }
</style>
---
const { maxHeight = "60vh", slantMove = false, id = "0" } = Astro.props;
---

<div id={id} class="sideBlock" style={`max-height: ${maxHeight}`}>
    <slot />
</div>

<script define:vars={{ slantMove, id }}>
    if (slantMove)
    {
        const container = document.getElementById(id);
        if (!container)
        {
            console.error(`the QNBlock id ${id} is not existing!`);
            return;
        }

        container.addEventListener("scroll", () =>
        {
            const progress = container.scrollTop / 50;

            console.log(progress);

        });
    }
</script>



<style>
    .sideBlock
    {
        width: 230px;
        min-height: 10vh;

        padding: 10px;

        border-radius: 20px;

        background-color: #1f1e33;
        box-shadow: inset 0 8px 30px rgba(0, 0, 0, 0.8);

        white-space: nowrap;
        text-overflow: ellipsis;

        overflow-x: hidden;
        scrollbar-width: none;
    }
    .sideBlock::-webkit-scrollbar
    {
        display: none;
    }
</style>
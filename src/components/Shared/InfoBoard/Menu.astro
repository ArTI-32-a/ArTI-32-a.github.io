---
import { Common as C } from "@/utils/Common/Common";

import B from "./Board.astro";
import Btn from "./Button.astro";

export interface Props
{
    radius?: number;
    thicknessRatio?: number;
}

const { radius = C.INF_RING_RADIUS_UNIT_V, thicknessRatio = C.INF_RING_THICKNESS_RATIO_P } = Astro.props;

const offsetMin: number = C.INF_RING_OFFSET_MIN_RATIO_P * C.INF_RING_COUNT_N * C.INF_RING_RADIUS_UNIT_V;
---


<div
    class="contact-menu"
    id="contact-menu"
    data-state="closed"
    style={`--inf-ring-unit: ${C.INF_RING_RADIUS_UNIT_V}; 
            --inf-ring-offset: ${offsetMin}; 
            --inf-ring-fade-start: ${C.INF_RING_FADE_START_V}; 
            --inf-ring-fade-end: ${C.INF_RING_FADE_END_V};`}
>
    <div class="contact-ring" id="contact-ring">
        <div class="contact-overlay" id="contact-overlay">
            <button class="contact-overlay-x" type="button" aria-label="关闭">
                ×
            </button>
        </div>
        
        <div class="contact-ring-content" id="contact-ring-content">
            {Array.from({ length: C.INF_RING_COUNT_N }, (_, i) =>
            {
                const rMax = (i + 1) * C.INF_RING_RADIUS_UNIT_V;
                const thickness = rMax * C.INF_RING_THICKNESS_RATIO_P;

                return (
                    <svg
                        class="contact-ring-svg"
                        data-ring={i}
                        style={`--ring-index: ${i};`}
                        viewBox={`${-rMax * 1.2} ${-rMax * 1.2} ${rMax * 2.4} ${rMax * 2.4}`}
                        preserveAspectRatio="xMidYMid meet"
                    >
                        <defs>
                            <radialGradient
                                id={`ringGradient-${i}`}
                                cx="0"
                                cy="0"
                                r={rMax * (1 + C.INF_RING_THICKNESS_RATIO_P / 2)}
                                gradientUnits="userSpaceOnUse"
                            >
                                <stop
                                    offset={((1 - C.INF_RING_THICKNESS_RATIO_P / 2) / (1 + C.INF_RING_THICKNESS_RATIO_P / 2)).toFixed(4)}
                                    stop-color="#9a8aff"
                                    stop-opacity="0.35"
                                />
                                <stop
                                    offset="0.86"
                                    stop-color="#5a4a8a"
                                    stop-opacity="0.9"
                                />
                                <stop
                                    offset="0.909"
                                    stop-color="#3a2a6a"
                                    stop-opacity="0.9"
                                />
                                <stop
                                    offset="0.96"
                                    stop-color="#5a4a8a"
                                    stop-opacity="0.9"
                                />
                                <stop
                                    offset="1"
                                    stop-color="#9a8aff"
                                    stop-opacity="0.35"
                                />
                            </radialGradient>
                        </defs>

                        <circle
                            cx="0"
                            cy="0"
                            r={rMax}
                            fill="none"
                            stroke={`url(#ringGradient-${i})`}
                            stroke-width={thickness}
                        />
                    </svg>
                );
            })}

            <div class="contact-ring-inner">
                <Btn index={1} >
                    QQ
                </Btn>
                <Btn index={2}>
                    友链（？）
                </Btn>
                <Btn index={3} />
                <Btn index={4} />
                <Btn index={5} />
                <Btn index={6} />
                <Btn index={7} />
                <Btn index={8} />
                <Btn index={9} />
                <Btn index={10} />
                <Btn index={11} />
                <Btn index={12} />
            </div>
        </div>
    </div>
    
    <B index={0} />
    <B index={1} />
    <B index={2} />

</div>


<script>
    import { EventName as EN } from "@/utils/Common/Event";
    import { Common as C } from "@/utils/Common/Common";

    const offsetMin: number = C.INF_RING_OFFSET_MIN_RATIO_P
                            * C.INF_RING_COUNT_N
                            * C.INF_RING_RADIUS_UNIT_V;

    const offsetMax: number = C.INF_RING_OFFSET_MAX_V;

    (() =>
    {
        const menuEl = document.getElementById("contact-menu");
        if (!(menuEl instanceof HTMLElement)) 
        {
            return;
        }
        const overlayEl = document.getElementById("contact-overlay");
        if (!(overlayEl instanceof HTMLElement))
        {
            return;
        }

        const menu: HTMLElement = menuEl;
        const overlay: HTMLElement = overlayEl;

        let isOpen: boolean = false;
        let activeBoardIndex: number | null = null;

        let currentOffset: number = offsetMin;
        let targetOffset: number = offsetMin;
        let ringRafId: number | null = null;

        function applyRingRadius(): void
        {
            menu.style.setProperty("--inf-ring-offset", `${currentOffset}`);
        }

        function ringTick(): void
        {
            const diff = targetOffset - currentOffset;

            const outerRadius = C.INF_RING_COUNT_N * C.INF_RING_RADIUS_UNIT_V + currentOffset;

            const visuallyClosed = !isOpen && outerRadius <= C.INF_RING_FADE_END_V;

            if (visuallyClosed || Math.abs(diff) < C.INF_RING_EPSILON_V)
            {
                currentOffset = targetOffset;
                applyRingRadius();
                ringRafId = null;

                if (!isOpen && Math.abs(currentOffset - offsetMin) < C.INF_RING_CLOSE_EPSILON_V)
                {
                    menu.dataset.state = "closed";
                    document.dispatchEvent(new CustomEvent(EN.INF_MENU_CLOSE_EVENT));
                }

                return;
            }

            const lerp = isOpen ? C.INF_RING_OPEN_LERP_P : C.INF_RING_CLOSE_LERP_P;
            currentOffset += diff * lerp;
            applyRingRadius();
            ringRafId = requestAnimationFrame(ringTick);
        }

        function startRingLoop(): void
        {
            if (ringRafId !== null)
            {
                return;
            }
            ringRafId = requestAnimationFrame(ringTick);
        }

        function openMenu(): void
        {
            if (isOpen)
            {
                return;
            }
            isOpen = true;

            currentOffset = offsetMin;    // 从最小开始
            targetOffset = 0;              // 张开到 0
            applyRingRadius();

            menu.dataset.state = "open";
            startRingLoop();
        }

        function closeMenu(): void
        {
            if (!isOpen)
            {
                return;
            }
            isOpen = false;

            targetOffset = offsetMin;     // 缩回最小
            startRingLoop();
        }


        function findBoard(index: number): HTMLElement | null
        {
            const primary = menu.querySelector<HTMLElement>(
                `[data-board-index="${index}"]`
            );
            if (primary)
            {
                return primary;
            }
            return menu.querySelector<HTMLElement>(
                `[data-board-index="0"]`
            );
        }

        function openBoard(index: number): void
        {
            if (activeBoardIndex !== null && activeBoardIndex !== index)
            {
                closeBoard();
            }

            activeBoardIndex = index;

            const board = findBoard(index);
            if (board)
            {
                board.classList.add("opened");
            }

            const btn = menu.querySelector<HTMLElement>(
                `.contact-button[data-index="${index}"]`
            );
            if (btn)
            {
                btn.classList.add("active");
            }
        }

        function closeBoard(): void
        {
            if (activeBoardIndex === null) 
            {
                return;
            }

            menu.querySelectorAll<HTMLElement>(".information-board")
                .forEach(b => 
                {
                    console.log(b);
                    b.classList.remove("opened")
                });

            menu.querySelectorAll<HTMLElement>(".contact-button")
                .forEach(b => 
                {
                    b.classList.remove("active")
                });

            activeBoardIndex = null;
        }


        document.addEventListener(EN.INF_MENU_OPEN_EVENT, () =>
        {
            openMenu();
        });

        overlay.addEventListener("click", (e: MouseEvent) =>
        {
            const target = e.target;
            if (!(target instanceof Element)) return;

            if (target.closest(".contact-overlay-x"))
            {
                closeMenu();
            }
        });

        document.addEventListener(EN.INF_BOARD_OPEN_EVENT, (e: Event) =>
        {
            if (!(e instanceof CustomEvent))
            {
                return;
            }

            const detail = e.detail;
            if (typeof detail !== "object" || detail === null)
            {
                return;
            }
            if (!("index" in detail))
            {
                return;
            }
            if (typeof detail.index !== "number")
            {
                return;
            }

            openBoard(detail.index);
        });

        document.addEventListener(EN.INF_BOARD_CLOSE_EVENT, (e: Event) =>
        {
            if (!(e instanceof CustomEvent))
            {
                return;
            }

            closeBoard();
        });

        document.addEventListener("keydown", (e: KeyboardEvent) =>
        {
            if (e.key !== "Escape")
            {
                return;
            }
            if (!isOpen)
            {
                return;
            }

            if (activeBoardIndex !== null)
            {
                closeBoard();
            }
            else
            {
                closeMenu();
            }
        });

        document.addEventListener("wheel", (e: WheelEvent) =>
        {
            if (!isOpen)
            {
                return;
            }

            e.preventDefault();

            const delta: number = e.deltaY > 0
                ? -C.INF_RING_SCROLL_STEP_V
                : C.INF_RING_SCROLL_STEP_V;

            targetOffset = Math.max(
                offsetMin,
                Math.min(C.INF_RING_OFFSET_MAX_V, targetOffset + delta)
            );

            startRingLoop();
        }, { passive: false });
    })();

    
</script>



<style>
    .contact-menu
    {
        /* 1. 布局定位 */
        position: fixed;
        inset: 0;
        z-index: 9000;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-ring
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;

        /* 2. 盒模型 - 尺寸与排列 */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .contact-ring-content
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 9000;

        /* 2. 盒模型 - 尺寸与排列 */
        display: flex;
        align-items: center;
        justify-content: center;
        width: 0;
        height: 0;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-menu[data-state="closed"] .contact-ring-content
    {
        /* 7. 视觉效果 */
        visibility: hidden;
    }

    .contact-ring-svg
    {
        /* 1. 布局定位 */
        position: absolute;
        left: 0;
        top: 0;
        z-index: 9100;

        /* 2. 盒模型 - 尺寸与排列 */
        --ring-radius-raw: calc((var(--ring-index) + 1) * var(--inf-ring-unit) + var(--inf-ring-offset));
        --ring-radius-clamped: max(0, var(--ring-radius-raw));
        width: calc(var(--ring-radius-clamped) * 2.4 * 1vmin);
        height: calc(var(--ring-radius-clamped) * 2.4 * 1vmin);
        flex-shrink: 0;

        /* 7. 视觉效果 */
        --ring-fade-range: calc(var(--inf-ring-fade-start) - var(--inf-ring-fade-end));
        opacity: clamp(0, calc((var(--ring-radius-clamped) - var(--inf-ring-fade-end)) / var(--ring-fade-range)), 1);

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    .contact-ring-inner
    {
        /* 1. 布局定位 */
        position: absolute;
        left: 0;
        top: 0;
        z-index: 9500;

        /* 2. 盒模型 - 尺寸与排列 */
        width: 0;
        height: 0;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-overlay
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;
        z-index: 8000;

        /* 5. 背景与阴影 */
        background-color: rgba(0, 0, 0, 0.5);

        /* 7. 视觉效果 */
        opacity: 0;
        visibility: hidden;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .contact-menu[data-state="open"] .contact-overlay
    {
        /* 7. 视觉效果 */
        opacity: 1;
        visibility: visible;

        /* 9. 交互 */
        pointer-events: auto;
    }

    .contact-overlay-x
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 2rem;
        right: 2rem;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸与排列 */
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;

        /* 4. 边框圆角 */
        border-radius: 50%;
        border: none;

        /* 5. 背景与阴影 */
        background-color: rgba(200, 60, 60, 0.9);
        box-shadow: 0 0.3rem 0.8rem rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.6rem;
        line-height: 1;

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transition: background-color 0.2s, transform 0.2s;
    }

    .contact-overlay-x:hover
    {
        /* 5. 背景与阴影 */
        background-color: rgba(220, 80, 80, 1);

        /* 10. 动画过渡 */
        transform: scale(1.1);
    }
</style>
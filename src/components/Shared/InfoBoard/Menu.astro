---
import { Common as C } from "@/utils/Common/Common";

import B from "./Board.astro";
import Btn from "./Button.astro";
import G from "./Geometry.astro";

export interface Props
{
    radius?: number;
    thicknessRatio?: number;
}

const { radius = C.INF_RING_RADIUS_UNIT_V, thicknessRatio = C.INF_RING_THICKNESS_RATIO_P } = Astro.props;

const offsetMin: number = C.INF_RING_OFFSET_MIN_RATIO_P * C.INF_RING_COUNT_N * C.INF_RING_RADIUS_UNIT_V;
---



<div
    class="contact-menu"
    id="contact-menu"
    data-state="closed"
    style={`--inf-ring-unit: ${C.INF_RING_RADIUS_UNIT_V}; 
            --inf-ring-offset: ${offsetMin}; 
            --inf-ring-fade-start: ${C.INF_RING_FADE_START_V}; 
            --inf-ring-fade-end: ${C.INF_RING_FADE_END_V};`}
>
    <div class="contact-ring" id="contact-ring">
        <G />
        <div class="contact-overlay" id="contact-overlay">
            <button class="contact-overlay-x" type="button" aria-label="关闭">
                ×
            </button>
        </div>
        
        <div class="contact-ring-content" id="contact-ring-content">
            {Array.from({ length: C.INF_RING_COUNT_N }, (_, i) =>
            {
                const rMax = (i + 1) * C.INF_RING_RADIUS_UNIT_V;
                const thickness = rMax * C.INF_RING_THICKNESS_RATIO_P;

                return (
                    <svg
                        class="contact-ring-svg"
                        data-ring={i}
                        style={`--ring-index: ${i};`}
                        viewBox={`${-rMax * 1.2} ${-rMax * 1.2} ${rMax * 2.4} ${rMax * 2.4}`}
                        preserveAspectRatio="xMidYMid meet"
                    >
                        <defs>
                            <radialGradient
                                id={`ringGradient-${i}`}
                                cx="0"
                                cy="0"
                                r={rMax * (1 + C.INF_RING_THICKNESS_RATIO_P / 2)}
                                gradientUnits="userSpaceOnUse"
                            >
                                <stop
                                    offset={((1 - C.INF_RING_THICKNESS_RATIO_P / 2) / (1 + C.INF_RING_THICKNESS_RATIO_P / 2)).toFixed(4)}
                                    stop-color="#9a8aff"
                                    stop-opacity="0.35"
                                />
                                <stop
                                    offset="0.86"
                                    stop-color="#5a4a8a"
                                    stop-opacity="0.9"
                                />
                                <stop
                                    offset="0.909"
                                    stop-color="#3a2a6a"
                                    stop-opacity="0.9"
                                />
                                <stop
                                    offset="0.96"
                                    stop-color="#5a4a8a"
                                    stop-opacity="0.9"
                                />
                                <stop
                                    offset="1"
                                    stop-color="#9a8aff"
                                    stop-opacity="0.35"
                                />
                            </radialGradient>
                        </defs>

                        <circle
                            cx="0"
                            cy="0"
                            r={rMax}
                            fill="none"
                            stroke={`url(#ringGradient-${i})`}
                            stroke-width={thickness}
                        />
                    </svg>
                );
            })}

            <div class="contact-ring-inner">
                <Btn index={1} >
                    QQ
                </Btn>
                <Btn index={2}>
                    友链（？）
                </Btn>
                <Btn index={3} />
                <Btn index={4} />
                <Btn index={5} />
                <Btn index={6} />
                <Btn index={7} />
                <Btn index={8} />
                <Btn index={9} />
                <Btn index={10} />
                <Btn index={11} />
                <Btn index={12} />
            </div>
        </div>
    </div>
    
    <B index={0} />
    <B index={1} />
    <B index={2} />

</div>



<script>
    import { initMenuController } from "@/utils/InfoBoard/MenuController";

    (() =>
    {
        const menuEl = document.getElementById("contact-menu");
        if (!(menuEl instanceof HTMLElement))
        {
            return;
        }

        const menu = menuEl;
        const overlayEl = menu.querySelector("#contact-overlay");
        if (!(overlayEl instanceof HTMLElement))
        {
            return;
        }

        const overlay = overlayEl;
        initMenuController(menu, overlay);
    })();
</script>



<style>
    .contact-menu
    {
        /* 1. 布局定位 */
        position: fixed;
        inset: 0;
        z-index: 9000;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-ring
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;

        /* 2. 盒模型 - 尺寸与排列 */
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .contact-ring-content
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 9000;

        /* 2. 盒模型 - 尺寸与排列 */
        display: flex;
        align-items: center;
        justify-content: center;
        width: 0;
        height: 0;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-menu[data-state="closed"] .contact-ring-content
    {
        /* 7. 视觉效果 */
        visibility: hidden;
    }

    .contact-ring-svg
    {
        /* 1. 布局定位 */
        position: absolute;
        left: 0;
        top: 0;
        z-index: 9100;

        /* 2. 盒模型 - 尺寸与排列 */
        --ring-radius-raw: calc((var(--ring-index) + 1) * var(--inf-ring-unit) + var(--inf-ring-offset));
        --ring-radius-clamped: max(0, var(--ring-radius-raw));
        width: calc(var(--ring-radius-clamped) * 2.4 * 1vmin);
        height: calc(var(--ring-radius-clamped) * 2.4 * 1vmin);
        flex-shrink: 0;

        /* 7. 视觉效果 */
        --ring-fade-range: calc(var(--inf-ring-fade-start) - var(--inf-ring-fade-end));
        opacity: clamp(0, calc((var(--ring-radius-clamped) - var(--inf-ring-fade-end)) / var(--ring-fade-range)), 1);

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    .contact-ring-inner
    {
        /* 1. 布局定位 */
        position: absolute;
        left: 0;
        top: 0;
        z-index: 9500;

        /* 2. 盒模型 - 尺寸与排列 */
        width: 0;
        height: 0;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-overlay
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;
        z-index: 8000;

        /* 5. 背景与阴影 */
        background-color: rgba(0, 0, 0, 0.5);

        /* 7. 视觉效果 */
        opacity: 0;
        visibility: hidden;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transition: opacity 0.4s ease, visibility 0.4s ease;
    }

    .contact-menu[data-state="open"] .contact-overlay
    {
        /* 7. 视觉效果 */
        opacity: 1;
        visibility: visible;

        /* 9. 交互 */
        pointer-events: auto;
    }

    .contact-overlay-x
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 2rem;
        right: 2rem;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸与排列 */
        display: grid;
        place-items: center;
        width: 3rem;
        height: 3rem;

        /* 4. 边框圆角 */
        border-radius: 50%;
        border: none;

        /* 5. 背景与阴影 */
        background-color: rgba(200, 60, 60, 0.9);
        box-shadow: 0 0.3rem 0.8rem rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.6rem;
        line-height: 1;

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transition: background-color 0.2s, transform 0.2s;
    }

    .contact-overlay-x:hover
    {
        /* 5. 背景与阴影 */
        background-color: rgba(220, 80, 80, 1);

        /* 10. 动画过渡 */
        transform: scale(1.1);
    }
</style>

---
import type { ContactsData, ContentBlock } from "@/utils/Common/Type";
import type { JSX } from "astro/jsx-runtime";

import contactsRaw from "@/data/InfBoard/contacts.json";

import { isContactsData } from "@/utils/Common/TGuards";

export interface Props
{
    index: number;
}

const { index } = Astro.props;

const contacts: ContactsData = isContactsData(contactsRaw) ? contactsRaw : {};
const key: string = String(index);
const blocks = contacts[key as keyof typeof contacts] ?? [];
---

<div class="information-board" data-board-index={index}>
    <div class="information-board-content">
        {(() =>
        {
            function renderBlock(block: ContentBlock): JSX.Element | null
            {
                switch (block.type)
                {
                    case "title":
                        return (
                            <div class={`ib-title ib-title-h${block.level}`}>
                                {block.text}
                            </div>
                        );

                    case "text":
                        return <p class="ib-text">{block.text}</p>;

                    case "paragraph":
                        return (
                            <p class="ib-paragraph">
                                {block.children.map(child => renderBlock(child))}
                            </p>
                        );

                    case "image":
                        return (
                            <img
                                class="ib-image"
                                src={block.src}
                                alt={block.alt ?? ""}
                            />
                        );

                    case "link":
                        return <a class="ib-link" href={block.href}>{block.text}</a>;

                    case "other":
                        return <p class="ib-other">{block.text}</p>;
                }
            }

            return blocks.map(block => renderBlock(block));
        })()}
    </div>

    <button class="information-board-x" type="button" aria-label="关闭">
        ×
    </button>
    <button class="information-board-bar"  type="button" aria-label="关闭">
        ×
    </button>
</div>



<script>
    import { EventName as EN } from "@/utils/Common/Event";

    if (!window.__infBoardDelegation)
    {
        window.__infBoardDelegation = true;

        document.addEventListener("click", (e: MouseEvent) =>
        {
            const targetEl = e.target;
            if (!(targetEl instanceof Element))
            {
                return;
            }
            const target: Element = targetEl;

            const onX = target.closest(".information-board-x") !== null;
            const onBar = target.closest(".information-board-bar") !== null;
            if (!onX && !onBar)
            {
                return;
            }

            const boardEl = target.closest(".information-board");
            if (!(boardEl instanceof HTMLElement))
            {
                return;
            }
            const board: HTMLElement = boardEl;

            const index = Number(board.dataset.boardIndex ?? "-1");
            if (index < 0)
            {
                return;
            }

            document.dispatchEvent(new CustomEvent(
                EN.INF_BOARD_CLOSE_EVENT,
                { detail: { index } }
            ));
        });
    }
</script>



<style>
    .information-board
    {
        /* 1. 布局定位 */
        position: fixed;
        left: 0;
        top: 0;
        z-index: 10000;

        /* 2. 盒模型 - 尺寸 */
        display: flex;
        width: var(--inf-board-width, 35vw);
        height: 100vh;
        box-sizing: border-box;

        /* 4. 边框圆角 */
        border-radius: 0 1rem 1rem 0;

        /* 5. 背景 */
        background-color: rgba(20, 20, 40, 0.96);
        backdrop-filter: blur(8px);
        border-right: 1px solid rgba(154, 138, 255, 0.3);
        box-shadow: 4px 0 16px rgba(0, 0, 0, 0.5);

        /* 7. 视觉效果 */
        visibility: hidden;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transform: translateX(-100%);
        transition:
            transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
            visibility 0.4s ease;
    }

    .information-board::before
    {
        /* 1. 布局定位 */
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 100%;
        right: -100vw;
        z-index: -1;

        /* 5. 背景 */
        background-color: rgba(0, 0, 0, 0.4);

        /* 9. 交互 */
        pointer-events: none;
    }

    .information-board.opened
    {
        /* 7. 视觉效果 */
        visibility: visible;

        /* 9. 交互 */
        pointer-events: auto;

        /* 10. 动画过渡 */
        transform: translateX(0);
    }

    .information-board-content
    {
        /* 2. 盒模型 - 尺寸 */
        flex: 1;
        min-width: 0;

        /* 3. 盒模型 - 间距 */
        padding: 2rem;

        /* 6. 文字 */
        color: #ffffff;

        /* 8. 溢出滚动 */
        overflow-y: auto;
        scrollbar-width: none;
    }

    .information-board-content::-webkit-scrollbar
    {
        /* 7. 视觉效果 */
        display: none;
    }

    .information-board-x
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 1rem;
        right: 2.5rem;
        z-index: 2;

        /* 2. 盒模型 - 尺寸 */
        width: 2.5rem;
        height: 2.5rem;

        /* 4. 边框圆角 */
        border-radius: 50%;
        border: none;

        /* 5. 背景 */
        background-color: rgba(200, 60, 60, 0.9);
        box-shadow: 0 0.2rem 0.6rem rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.5rem;
        line-height: 1;

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transition: background-color 0.2s, transform 0.2s;
    }

    .information-board-x:hover
    {
        /* 5. 背景 */
        background-color: rgba(220, 80, 80, 1);

        /* 10. 动画过渡 */
        transform: scale(1.1);
    }

    .information-board-bar
    {   
        display: grid;
        place-items: center;

        /* 1. 布局定位 */
        position: absolute;
        top: 50%;
        left: calc((100% + 100vw) / 2);
        z-index: 11000;

        /* 2. 盒模型 - 尺寸 */
        width: 5rem;
        height: 90vh;

        /* 3. 盒模型 - 间距 */
        padding: 0;

        /* 4. 边框圆角 */
        border-radius: 0.2rem;
        border: 0.3rem solid rgba(255, 0, 0, 1);   

        /* 5. 背景 */
        background-color: rgba(200, 60, 60, 0.65);
        box-shadow: 0 0.3rem 1rem rgba(0, 0, 0, 0.4);
        
        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.5rem;
        line-height: 1;
        text-align: center;
        
        /* 7. 视觉效果 */
        opacity: 0;

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%) scale(0.3);
        transition:
            background-color 0.2s,
            width 0.2s,
            opacity 0s 0s,
            transform 0s 0s;
    }

    .information-board-bar:hover
    {
        background-color: rgba(220, 80, 80, 0.85);
    }

    .information-board.opened .information-board-bar
    {
        /* 7. 视觉效果 */
        opacity: 1;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%) scale(1);
        transition:
            background-color 0.2s,
            width 0.2s,
            opacity 0.3s ease 0.4s,      /* 延迟 0.4s（等 board 滑完） */
            transform 0.3s ease 0.4s;
    }

    .ib-title
    {
        /* 3. 盒模型 - 间距 */
        margin: 1rem 0 0.8rem;

        /* 6. 文字 */
        color: #ffffff;
        font-weight: 700;
        line-height: 1.3;
        word-break: break-word;
    }

    .ib-title-h1 { font-size: 2rem; }
    .ib-title-h2 { font-size: 1.6rem; }
    .ib-title-h3 { font-size: 1.3rem; }
    .ib-title-h4 { font-size: 1.1rem; }
    .ib-title-h5 { font-size: 1rem; }
    .ib-title-h6 { font-size: 0.9rem; }

    .ib-text,
    .ib-paragraph
    {
        /* 3. 盒模型 - 间距 */
        margin: 0.6rem 0;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.9);
        font-size: 1rem;
        line-height: 1.6;
        word-break: break-word;
    }

    .ib-paragraph :global(a)
    {
        /* 6. 文字 */
        color: #9a8aff;
        text-decoration: underline;
        text-underline-offset: 0.2em;

        /* 10. 动画过渡 */
        transition: color 0.2s;
    }

    .ib-paragraph :global(a:hover)
    {
        /* 6. 文字 */
        color: #b8aeff;
    }

    .ib-paragraph :global(img)
    {
        /* 2. 盒模型 - 尺寸 */
        display: inline-block;
        max-width: 100%;
        vertical-align: middle;
    }

    .ib-image
    {
        /* 2. 盒模型 - 尺寸 */
        display: block;
        max-width: 100%;
        height: auto;

        /* 3. 盒模型 - 间距 */
        margin: 1rem 0;

        /* 4. 边框圆角 */
        border-radius: 0.5rem;

        /* 5. 背景 */
        box-shadow: 0 0.3rem 1rem rgba(0, 0, 0, 0.4);
    }

    .ib-link
    {
        /* 2. 盒模型 - 尺寸 */
        display: inline-block;

        /* 3. 盒模型 - 间距 */
        margin: 0.3rem 0;

        /* 6. 文字 */
        color: #9a8aff;
        text-decoration: underline;
        text-underline-offset: 0.2em;

        /* 10. 动画过渡 */
        transition: color 0.2s;
    }

    .ib-link:hover
    {
        /* 6. 文字 */
        color: #b8aeff;
    }

    .ib-other
    {
        /* 3. 盒模型 - 间距 */
        margin: 0.6rem 0;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.7);
        font-size: 1rem;
        line-height: 1.6;
    }
</style>

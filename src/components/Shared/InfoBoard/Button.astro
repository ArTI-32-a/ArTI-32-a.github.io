---
import { Common as C } from "@/utils/Common/Common";

export interface Props
{
    index: number;
    radius?: number;
}

const { index, radius = C.INF_RING_RADIUS_UNIT_V } = Astro.props;

const zeroIndex: number = index - 1;
const ringIndex: number = Math.floor(zeroIndex / 12);

const angle: number = (zeroIndex % C.INF_RING_BTN_PER_RING) * C.INF_RING_BTN_ANGLE;
const halfAngle: number = C.INF_RING_BTN_ANGLE / 2;
const halfStep: number = (C.INF_RING_BTN_ANGLE - C.INF_RING_BTN_GAP) / 2;

// 局部坐标系：原点在弧段中点（圆周上），x 轴沿径向向外，y 轴沿切向
// 弧心在 (-r, 0)
const r: number = radius;
const thickness: number = r * C.INF_RING_THICKNESS_RATIO * C.INF_RING_BTN_RATIO;
const ri: number = r - thickness / 2;
const ro: number = r + thickness / 2;

const cx: number = -r;
const cy: number = 0;

const a1: number = (-halfStep) * Math.PI / 180;
const a2: number = (+halfStep) * Math.PI / 180;
// const a1: number = -Math.PI / 2 - (halfStep * Math.PI / 180);
// const a2: number = -Math.PI / 2 + (halfStep * Math.PI / 180);

// 内弧起点 / 终点
const x1: number = cx + ri * Math.cos(a1);
const y1: number = cy + ri * Math.sin(a1);
const x2: number = cx + ri * Math.cos(a2);
const y2: number = cy + ri * Math.sin(a2);
// 外弧终点 / 起点
const x3: number = cx + ro * Math.cos(a2);
const y3: number = cy + ro * Math.sin(a2);
const x4: number = cx + ro * Math.cos(a1);
const y4: number = cy + ro * Math.sin(a1);

const arcPath: string =
    `M ${x1} ${y1} ` +
    `A ${ri} ${ri} 0 0 1 ${x2} ${y2} ` +
    `L ${x3} ${y3} ` +
    `A ${ro} ${ro} 0 0 0 ${x4} ${y4} Z`;

// viewBox 留点余量
const vbX: number = -r * 0.15;
const vbY: number = -r * 0.3;
const vbW: number = r * 0.3;
const vbH: number = r * 0.6;
// const vbX: number = -r * 0.3;
// const vbY: number = -r * 0.15;
// const vbW: number = r * 0.6;
// const vbH: number = r * 0.3;
---

<div
    class="contact-button"
    data-index={index}
    style={`--angle: ${angle}; --half-angle: ${halfAngle}; --ring-index: ${ringIndex};`}
>
    <svg
        class="contact-button-svg"
        viewBox={`${vbX} ${vbY} ${vbW} ${vbH}`}
        preserveAspectRatio="xMidYMid meet"
    >
        <defs>
            <linearGradient
                id={`btnGradient-${index}`}
                x1={vbX}
                y1="0"
                x2={vbX + vbW}
                y2="0"
                gradientUnits="userSpaceOnUse"
            >
            <!-- <linearGradient
                id={`btnGradient-${index}`}
                x1={-r * 0.15}
                y1="0"
                x2={r * 0.15}
                y2="0"
                gradientUnits="userSpaceOnUse"
            > -->
                <stop offset="0" style="stop-color: var(--btn-color-edge-inner, rgba(40, 35, 70, 0.9))" />
                <stop offset="0.4" style="stop-color: var(--btn-color-hl, rgba(120, 105, 200, 0.95))" />
                <stop offset="0.7" style="stop-color: var(--btn-color-mid, rgba(90, 75, 150, 0.9))" />
                <stop offset="1" style="stop-color: var(--btn-color-edge-outer, rgba(30, 25, 55, 0.95))" />
            </linearGradient>
        </defs>

        <path
            class="contact-arc"
            d={arcPath}
            fill={`url(#btnGradient-${index})`}
            stroke="var(--btn-stroke)"
            stroke-width="0.3"
        />
        <!-- <g transform="rotate(90)">
            <path
                class="contact-arc"
                d={arcPath}
                fill={`url(#btnGradient-${index})`}
                stroke="var(--btn-stroke)"
                stroke-width="0.3"
            />
        </g> -->
    </svg>

    <span class="contact-button-label">
        <slot />
    </span>
</div>


<script>
    import { EventName as EN } from "@/utils/Common/Event";

    
    if (!window.__infButtonDelegation)
    {
        window.__infButtonDelegation = true;

        document.addEventListener("click", (e: MouseEvent) =>
        {
            const targetEl = e.target;
            if (!(targetEl instanceof Element))
            {
                return;
            }
            const target: Element = targetEl;

            const btnEl = target.closest(".contact-button");
            if (!(btnEl instanceof HTMLElement))
            {
                return;
            }
            const btn: HTMLElement = btnEl;

            const index = Number(btn.dataset.index ?? "-1");
            if (index < 0)
            {
                return;
            }

            document.dispatchEvent(new CustomEvent(
                EN.INF_BOARD_OPEN_EVENT,
                { detail: { index } }
            ));
        });
    }
</script>


<style>
    .contact-button
    {
        /* 1. 布局定位 */
        position: absolute;
        left: 0;
        top: 0;

        /* 2. 盒模型 - 尺寸 */
        display: flex;
        align-items: center;
        justify-content: center;

        --ring-radius-raw: calc((var(--ring-index) + 1) * var(--inf-ring-unit) + var(--inf-ring-offset));
        --ring-radius: max(0vmin, var(--ring-radius-raw));
        --ring-fade-range: calc(var(--inf-ring-fade-start) - var(--inf-ring-fade-end));

        width: calc(var(--ring-radius) * 0.3);
        height: calc(var(--ring-radius) * 0.6);
        /* width: calc(var(--ring-radius) * 0.6); */
        /* height: calc(var(--ring-radius) * 0.3); */

        /* 7. 视觉效果 */
        --btn-color-edge-inner: rgba(40, 35, 70, 0.9);
        --btn-color-hl: rgba(120, 105, 200, 0.95);
        --btn-color-mid: rgba(90, 75, 150, 0.9);
        --btn-color-edge-outer: rgba(30, 25, 55, 0.95);
        --btn-stroke: rgba(180, 165, 255, 0.4);

        opacity: clamp(0, calc((var(--ring-radius) - var(--inf-ring-fade-end)) / var(--ring-fade-range)), 1);


        /* 9. 交互 */
        cursor: pointer;
        pointer-events: auto;

        /* 10. 动画过渡 */
        transform:
            translate(-50%, -50%)
            rotate(calc((var(--angle) - var(--half-angle) + 30) * -1deg))
            translateX(var(--ring-radius));
    }

    .contact-button-svg
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;

        /* 2. 盒模型 - 尺寸 */
        display: block;
        width: 100%;
        height: 100%;

        /* 9. 交互 */
        pointer-events: none;
    }

    .contact-button:hover
    {
        /* 7. 视觉效果 */
        --btn-color-edge-inner: rgba(60, 55, 100, 0.9);
        --btn-color-hl: rgba(160, 145, 240, 1);
        --btn-color-mid: rgba(130, 115, 200, 0.95);
        --btn-color-edge-outer: rgba(50, 45, 85, 0.95);
        --btn-stroke: rgba(220, 210, 255, 0.9);
    }

    .contact-button.active
    {
        /* 7. 视觉效果 */
        --btn-color-edge-inner: rgba(90, 45, 105, 0.9);
        --btn-color-hl: rgba(225, 120, 255, 1);
        --btn-color-mid: rgba(170, 75, 200, 0.95);
        --btn-color-edge-outer: rgba(75, 35, 90, 0.95);
        --btn-stroke: rgba(245, 170, 255, 1);
    }

    .contact-button-label
    {
        /* 1. 布局定位 */
        /* position: absolute; */
        /* left: 50%; */
        /* top: 50%; */
        /* z-index: 1; */

        /* 2. 盒模型 - 尺寸 */
        /* display: grid; */
        /* place-items: center; */

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.25rem;
        font-family: 'Georgia', 'Noto Serif SC', serif;
        user-select: none;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transform: rotate(90deg);
    }
</style>

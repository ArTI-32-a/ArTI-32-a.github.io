            </p>
        </div>


        <slot name="horizontal" />
    </div>

    <div class="footer-site-vertical">
        <slot name="vertical" />
    </div>
</footer>



<script>
    import { pageviewCount } from "@waline/client/pageview";

    (() =>
    {
        const counterEl = document.getElementById("site-view-count");

        if (!(counterEl instanceof HTMLElement))
        {
            return;
        }

        const counter = counterEl;
        const path = counter.dataset.path;

        if (!path)
        {
            return;
        }

        const hostname: string = window.location.hostname;

        if (hostname === "localhost" || hostname === "127.0.0.1" || hostname === "[::1]")
        {
            counter.textContent = "本地不统计";
            return;
        }

        pageviewCount(
        {
            serverURL: "https://blog-comments-server-six.vercel.app",
            selector: "#site-view-count",
            path,
            update: true,
            lang: "zh-CN",
        });
    })();
</script>




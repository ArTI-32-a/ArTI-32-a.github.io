---
import Base from "./Base.astro";
---



<div class="floating-footer" tabindex="0" aria-label="版权与站点信息">
    <div class="footer-handle">
        <div class="footer-arrows" aria-hidden="true">
            <span class="footer-arrow footer-arrow-top" />
            <span class="footer-arrow footer-arrow-middle" />
            <span class="footer-arrow footer-arrow-bottom" />
        </div>

        <span class="footer-handle-label">
            版权 &amp; 站点信息
        </span>
    </div>

    <Base>
        <Fragment slot="horizontal">
            <slot name="horizontal" />
        </Fragment>

        <Fragment slot="vertical">
            <slot name="vertical" />
        </Fragment>
    </Base>
</div>



<style>
    .floating-footer
    {
        /* 1. 布局定位 */
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 120000;

        /* 2. 盒模型 - 尺寸与排列 */
        --footer-handle-height: 3rem;
        width: 100%;

        /* 5. 背景与阴影 */
        --footer-bg: transparent;

        /* 7. 视觉效果 */
        outline: none;

        /* 10. 动画过渡 */
        transform: translateY(calc(100% - var(--footer-handle-height)));
        transition: 
            transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
        transition-delay: 0.1s;
    }

    .floating-footer:focus-within,
    .floating-footer:hover
    {
        /* 5. 背景与阴影 */
        --footer-bg: #12111c;
        box-shadow: 0 -0.5rem 1.5rem rgba(0, 0, 0, 0.35);

        /* 10. 动画过渡 */
        transform: translateY(0);
        transition-delay: 0s;
    }

    .footer-handle
    {
        /* 1. 布局定位 */
        position: relative;

        /* 2. 盒模型 - 尺寸与排列 */
        display: grid;
        place-items: center;
        height: var(--footer-handle-height);

        /* 5. 背景与阴影 */
        background-color: transparent;

        /* 9. 交互 */
        cursor: default;
    }

    .footer-arrows
    {
        /* 1. 布局定位 */
        position: absolute;
        left: 50%;
        top: 50%;
        z-index: 1;

        /* 2. 盒模型 - 尺寸与排列 */
        display: flex;
        flex-direction: column;
        align-items: center;

        /* 3. 间距 */
        gap: 0.15rem;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    .footer-arrow
    {
        /* 2. 盒模型 - 尺寸与排列 */
        width: 1.1rem;
        height: 0.45rem;

        /* 5. 背景与阴影 */
        background-color: #b8a7ff;

        /* 7. 视觉效果 */
        clip-path: polygon(
            0 100%,
            0 65%,
            50% 0,
            100% 65%,
            100% 100%,
            50% 35%
        );

        /* 10. 动画过渡 */
        animation-duration: 2.4s;
        animation-timing-function: ease-in-out;
        animation-iteration-count: infinite;
    }

    .footer-arrow-bottom
    {
        /* 10. 动画过渡 */
        animation-name: footer-arrow-first;
    }

    .footer-arrow-middle
    {
        /* 10. 动画过渡 */
        animation-name: footer-arrow-second;
    }

    .footer-arrow-top
    {
        /* 10. 动画过渡 */
        animation-name: footer-arrow-third;
    }

    .footer-handle-label
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 2;

        /* 6. 文字 */
        color: #eee8ff;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-shadow:
            0 1px 3px #12111c,
            0 0 8px #12111c;

        /* 9. 交互 */
        pointer-events: none;
        user-select: none;
    }

    /* 三个箭头一起上抬，再从底部到顶部依次落下。 */
    @keyframes footer-arrow-first
    {
        0%, 65%, 100%
        {
            transform: translateY(0);
            opacity: 0.35;
        }

        18%, 28%
        {
            transform: translateY(-0.35rem);
            opacity: 1;
        }

        42%
        {
            transform: translateY(0);
            opacity: 0.35;
        }
    }

    @keyframes footer-arrow-second
    {
        0%, 65%, 100%
        {
            transform: translateY(0);
            opacity: 0.35;
        }

        18%, 38%
        {
            transform: translateY(-0.35rem);
            opacity: 1;
        }

        52%
        {
            transform: translateY(0);
            opacity: 0.35;
        }
    }

    @keyframes footer-arrow-third
    {
        0%, 65%, 100%
        {
            transform: translateY(0);
            opacity: 0.35;
        }

        18%, 48%
        {
            transform: translateY(-0.35rem);
            opacity: 1;
        }

        62%
        {
            transform: translateY(0);
            opacity: 0.35;
        }
    }

    @media (prefers-reduced-motion: reduce)
    {
        .footer-arrow
        {
            animation: none;
        }

        .floating-footer
        {
            transition: none;
        }
    }
</style>

---
import { Common as C } from "@/utils/Common/Common"

import PC from "@/components/WPs/__ForCatalog/__ForToEntry/PreviewCard.astro"

import type { WPCTFFormatter } from "@/utils/Common/Type"

interface Props
{
    id?: string;
    href: string;
    text: string;
    level?: number;
    data?: WPCTFFormatter
}


const { id = "0", href = "/", text = "...", level = 0, data } = Astro.props;

---

<a id={id} class="entry-link" href={href} style={`padding-left: ${level * C.WP_CAT_BTN_PADDING + 10}px`}>
    <span class="entry-text">
        {text}
    </span>
</a>

<PC id={id} data={data} />




<style>
    /*
        ---------- 1. 链接基础样式 ----------
    */
    .entry-link
    {
        /* 1. 布局定位 */
        position: relative;

        /* 2. 盒模型 - 尺寸 */
        display: block;

        /* 3. 盒模型 - 间距 */
        margin: 0.1rem 0;
        padding: 0.25rem 0;

        /* 4. 边框圆角 */
        border-radius: 8px;

        /* 6. 文字 */
        color: rgba(224, 225, 204, 0.8);
        font-family: "Courier New", "Fira Code", monospace;
        font-size: 0.95rem;
        line-height: 1.6;
        text-decoration: none;
        white-space: normal;
        word-break: break-word;

        /* 10. 动画过渡 */
        transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    }

    /*
        ---------- 2. 链接悬停效果 ----------
    */
    .entry-link:hover
    {
        /* 5. 背景 */
        background-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);

        /* 6. 文字 */
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 4px;
        text-decoration-thickness: 2px;
        text-decoration-color: #9a8aff;
    }

    /*
        ---------- 3. 文字本身 ----------
    */
    .entry-text
    {
        /* 2. 盒模型 - 尺寸 */
        display: inline;
    }

    /*
        ---------- 4. 悬停预览框 ----------
    */
    .hover-preview
    {
        /* 2. 盒模型 - 尺寸 */
        display: none;

        /* 3. 盒模型 - 间距 */
        margin-top: 100px;
        padding: 8px 12px;
        width: fit-content;

        /* 4. 边框圆角 */
        border-radius: 8px;

        /* 5. 背景 */
        background-color: rgba(30, 30, 50, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.1);

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        font-family: "Segoe UI", sans-serif;

        /* 图片占位，后续替换为 <img> 或背景图 */
    }

    .entry-link:hover .hover-preview
    {
        /* 2. 盒模型 - 尺寸 */
        display: inline-block;
    }

    /*
        ---------- 5. 预览占位图 ----------
    */
    .preview-placeholder
    {
        /* 2. 盒模型 - 尺寸 */
        display: flex;

        /* 3. 盒模型 - 间距 */
        padding: 4px 8px;

        /* 4. 边框圆角 */
        border-radius: 4px;

        /* 5. 背景 */
        background-color: rgba(255, 255, 255, 0.05);

        /* 2. 盒模型 - 尺寸（flex 对齐） */
        align-items: center;
        justify-content: center;

        /* 3. 盒模型 - 尺寸 */
        min-height: 40px;
    }
</style>
---
function isCTFFormatter(data: unknown): data is WPCTFFormatter
{
    // 1. 检查是否是对象
    if (typeof data !== "object" || data === null)
    {
        return false;
    }

    // 2. 检查 title 属性
    if (!("title" in data) || typeof data.title !== "string")
    {
        return false;
    }

    // 3. 检查 tags 属性
    if (!("tags" in data) || !Array.isArray(data.tags))
    {
        return false;
    }
    for (const tag of data.tags)
    {
        if (typeof tag !== "string")
        {
            return false;
        }
    }

    // 4. 检查 type 属性
    if (!("type" in data) || typeof data.type !== "string")
    {
        return false;
    }

    // 5. 检查 status 属性
    if (!("status" in data) || typeof data.status !== "string")
    {
        return false;
    }

    // 所有检查通过
    return true;
}


import type { WPCTFFormatter } from "@/utils/Common/Type";

interface Props 
{
    id: string,
    data: WPCTFFormatter | undefined,
}
const { id = "000" , data } = Astro.props;

if (!isCTFFormatter(data))
{
    throw new Error("data is not instance of ConData");
}
---


<div id={`preview-${id}`} class="preview-card">
    <div class="preview-tags">
        {data?.tags?.map(tag => <span class="tag">{tag}</span>)}
    </div>
    
    <div class="preview-title">
        {data?.questions && data.questions.length > 0
            ? data.questions.map(que => <div class="preview-title-item">{que}</div>)
            : "这里空空如也喵~"
        }
    </div>
</div>


<script define:vars={{ id, data }} lang="ts">
    const CARD_OFFSET = 15;
    const CARD_MAX_WIDTH = 280;
    const CARD_MAX_HEIGHT = 200;

    const btn = document.getElementById(id);
    const preview = document.getElementById(`preview-${id}`);

    if (!btn || !preview)
    {
        console.warn("href and preview cannot be found");
        return;
    }

    let timer = null;
    btn.addEventListener("mouseenter", () => 
    {
        timer = window.setTimeout(() => 
        {
            preview.style.display = "block";
        }, 100);
    });

    btn.addEventListener("mouseleave", () => 
    {
        if (timer !== null)
        {
            window.clearTimeout(timer);
            timer = null;
        }

        preview.style.display = "none";
    });

    btn.addEventListener("mousemove", (e) => 
    {
        let left = e.clientX + CARD_OFFSET;
        let top = e.clientY + CARD_OFFSET;

        if (left + CARD_MAX_WIDTH > window.innerWidth)
        {
            left = e.clientX - CARD_MAX_WIDTH + 2 * CARD_OFFSET;
        }

        if (top + CARD_MAX_HEIGHT > window.innerHeight)
        {
            top = e.clientY - CARD_MAX_HEIGHT + 2 * CARD_OFFSET;
        }

        preview.style.left = left + "px";
        preview.style.top = top + "px";
    });

</script>


<style>
    /*
        ---------- 1. 浮动卡片 ----------
    */
    .preview-card
    {
        /* 1. 布局定位 */
        position: fixed;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸 */
        display: none;
        max-width: 280px;

        /* 3. 盒模型 - 间距 */
        padding: 8px 12px;

        /* 4. 边框圆角 */
        border-radius: 8px;

        /* 5. 背景 */
        background-color: rgba(20, 20, 40, 0.95);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.9);
        font-family: "Segoe UI", sans-serif;
        font-size: 0.85rem;
        line-height: 1.5;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transition: opacity 0.15s ease;
    }

    /*
        ---------- 2. 标签容器 ----------
    */
    .preview-tags
    {
        /* 2. 盒模型 - 尺寸 */
        display: flex;
        flex-wrap: wrap;

        /* 3. 盒模型 - 间距 */
        gap: 4px;
        margin-bottom: 4px;
    }

    /*
        ---------- 3. 单个标签 ----------
    */
    .tag
    {
        /* 3. 盒模型 - 间距 */
        padding: 2px 6px;

        /* 4. 边框圆角 */
        border-radius: 4px;

        /* 5. 背景 */
        background-color: rgba(154, 138, 255, 0.2);

        /* 6. 文字 */
        color: #9a8aff;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.03em;
    }

    /*
        ---------- 4. 标题 ----------
    */
    .preview-title
    {
        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        word-break: break-word;
    }

    /*
        ---------- 单个标题项 ----------
    */
    .preview-title-item
    {
        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        word-break: break-word;
        line-height: 1.6;
    }
</style>
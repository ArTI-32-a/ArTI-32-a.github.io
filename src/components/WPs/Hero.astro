---
import type { MarkdownHeading } from "astro";

import type { WPCTFFormatter } from "@/utils/Common/Type";

export interface Props
{
    data: WPCTFFormatter;
    headings: MarkdownHeading[];
    backgroundImage: string;
}

const { data, headings, backgroundImage } = Astro.props;


let minDepth = Infinity;
for (const h of headings)
{
    if (h.depth >= 2 && h.depth < minDepth)
    {
        minDepth = h.depth;
    }
}

const topHeadings = (minDepth === Infinity ? [] : headings.filter(h => h.depth === minDepth));
---

<header class="hero" id="hero" style={`background-image: url(${backgroundImage});`}>
    <div class="hero-content">
        <div class="title-box">
            {data.title}
        </div>

        <div class="meta-block">
            <div class="type-tags">
                {data.type} : {data.tags.join(' ')}
            </div>

            <div class="heading-links">
                {topHeadings.map(h => (
                    <a href={`#${h.slug}`} class="heading-link">
                        {h.text}
                    </a>
                ))}
            </div>
        </div>
    </div>
</header>



<style>
    .hero
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸 */
        width: 100%;
        height: 60vh;
        overflow: hidden;

        /* 5. 背景 */
        background-position: center 20%;
        background-size: cover;
        background-repeat: no-repeat;
    }

    .hero-content
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 50%;
        left: 50%;

        /* 2. 盒模型 - 尺寸 */
        width: 100%;
        max-width: 800px;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 0 2rem;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    .title-box
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 5;

        /* 2. 盒模型 - 尺寸 */
        display: block;
        width: fit-content;
        max-width: 100%;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        margin: 0 auto;
        padding: 12px 32px;

        /* 4. 边框圆角 */
        border-radius: 100px;

        /* 5. 背景 */
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.3rem;
        font-weight: 700;
        text-align: center;
        word-break: break-word;

        /* 10. 动画 */
        transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    .meta-block
    {
        /* 3. 盒模型 - 间距 */
        margin-top: 1.5rem;
        padding: 1rem 1.5rem;

        /* 4. 边框圆角 */
        border-radius: 12px;

        /* 5. 背景 */
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(154, 138, 255, 0.15);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        text-indent: 4em;

        /* 10. 动画过渡 */
        transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1),
                    opacity 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    .type-tags
    {
        /* 3. 盒模型 - 间距 */
        margin-bottom: 1rem;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        line-height: 1.6;

        /* 8. 溢出滚动 */
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .heading-links
    {
        /* 2. 盒模型 - 尺寸 */
        display: block;
    }

    .heading-link
    {
        /* 2. 盒模型 - 尺寸 */
        display: block;

        /* 3. 盒模型 - 间距 */
        padding: 0.15rem 0;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.75);
        text-decoration: none;
        font-size: 0.9rem;
        line-height: 1.6;

        /* 8. 溢出滚动 */
        word-break: break-word;
        overflow-wrap: break-word;

        /* 10. 动画过渡 */
        transition: color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .heading-link:hover
    {
        /* 5. 背景（半透明光晕底色） */
        background-color: rgba(154, 138, 255, 0.12);
        box-shadow:
            inset 0 0 12px rgba(154, 138, 255, 0.3),
            0 0 12px rgba(154, 138, 255, 0.45),
            0 0 24px rgba(154, 138, 255, 0.2);
        
        /* 6. 文字 */
        color: #9a8aff;
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: rgba(154, 138, 255, 0.6);
        text-decoration-thickness: 1px;
        word-break: break-word;
        overflow-wrap: break-word;
        white-space: normal;

        /* 10. 动画过渡 */
        transform: translateX(4px);
    }


    /* 对接mask的 */
    .title-box.shrink
    {
        transform: translateY(-40px);
    }

    .meta-block.shrink
    {
        transform: translateY(-40px);
        opacity: 0;
    }
</style>
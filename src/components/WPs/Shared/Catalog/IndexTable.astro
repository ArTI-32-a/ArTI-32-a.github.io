---
export interface Props
{
    titles: string[];
    defaultIndex?: number;
}

const { titles, defaultIndex = 0 } = Astro.props;
---

<nav class="catalog-index" id="catalog-index">
    {titles.map((title, i) => (
        <div class="catalog-index-item" data-index={i}>
            {String(i + 1).padStart(2, "0")} / {title}
        </div>
    ))}
</nav>

<script>
    import { EventName as EN } from "@/utils/Common/Event";

    import { CatalogJumpEvent } from "@/utils/Common/Event";

    (() =>
    {
        const nav = document.getElementById("catalog-index");
        if (!(nav instanceof HTMLElement)) return;

        const items: HTMLElement[] = Array.from(
            nav.querySelectorAll<HTMLElement>(".catalog-index-item")
        );
        if (items.length === 0) return;

        let currentIndex: number = 0;

        function setActive(index: number): void
        {
            currentIndex = index;
            items.forEach((el, i) =>
            {
                el.classList.toggle("active", i === index);
            });
        }

        // 初始高亮
        const defaultIndex: number = Number(nav.dataset.defaultIndex ?? "0") || 0;
        setActive(defaultIndex);

        // 监听普通切换，同步高亮
        document.addEventListener(EN.WP_CAT_SWITCH_EVENT, (e: Event) =>
        {
            if (!(e instanceof CustomEvent)) return;

            const detail = e.detail as { counter?: number };

            if (typeof detail.counter !== "number") return;

            setActive(detail.counter % items.length);
        });

        // 点击 → 派发 jump
        items.forEach((el, i) =>
        {
            el.addEventListener("click", () =>
            {
                if (i === currentIndex) return;

                document.dispatchEvent(new CatalogJumpEvent(i));
            });
        });
    })();
</script>

<style>
    .catalog-index
    {
        /* 1. 布局定位 */
        position: fixed;
        right: 1.5rem;
        top: 50%;
        z-index: 10000;

        /* 2. 盒模型 - 尺寸 */
        display: flex;
        flex-direction: column;
        align-items: flex-end; 
        width: 14rem;          

        /* 3. 盒模型 - 间距 */
        gap: 0.5rem;

        /* 10. 动画过渡 */
        transform: translateY(-50%);
    }

    .catalog-index-item
    {
        /* 2. 盒模型 - 尺寸 */
        /* width: 14rem;*/
        width: 100%; 
        height: 3rem;
        display: flex;
        align-items: center;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 0.4rem 0.8rem;

        /* 4. 边框圆角 */
        border-radius: 8px;

        /* 5. 背景（默认也显示框） */
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(154, 138, 255, 0.25);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.4);
        font-family: "Courier New", "Fira Code", monospace;
        font-size: 0.85rem;
        text-align: left;
        word-break: break-word;

        /* 9. 交互 */
        cursor: pointer;
        user-select: none;

        /* 10. 动画过渡 */
        transform-origin: right center;
        transition: color 0.25s ease, background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .catalog-index-item:hover
    {
        /* 5. 背景 */
        background-color: rgba(154, 138, 255, 0.12);
        border-color: rgba(154, 138, 255, 0.6);
        box-shadow:
            inset 0 0 12px rgba(154, 138, 255, 0.3),
            0 0 12px rgba(154, 138, 255, 0.45),
            0 0 24px rgba(154, 138, 255, 0.2);

        /* 6. 文字 */
        color: #9a8aff;

        /* 10. 动画过渡 */
        /* transform: scale(1.1); */
    }

    .catalog-index-item.active
    {
        /* 5. 背景 */
        background-color: rgba(255, 216, 102, 0.1);
        box-shadow:
            inset 0 0 12px rgba(255, 216, 102, 0.2),
            0 0 12px rgba(255, 216, 102, 0.3);

        /* 6. 文字 */
        color: #ffd866;

        /* 10. 动画过渡 */
        transform: scale(1.15);
    }

    .catalog-index-item.active:hover
    {
        /* 激活项悬停时保持激活样式，不再放大 */
        transform: scale(1.15);
    }
</style>
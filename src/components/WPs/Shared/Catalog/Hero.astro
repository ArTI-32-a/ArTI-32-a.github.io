---
export interface Props
{
    titles: string[];
    defaultIndex?: number;
}

import Searcher from "@/components/WPs/Shared/Catalog/Searcher.astro";

const { titles, defaultIndex = 0 } = Astro.props;
---

<header class="catalog-hero">
    <Searcher placeholder="搜索文章、题目或标签…" />

    <div class="catalog-search-guide">
        <span>搜索范围：CTF && 电子取证</span>

        <details class="search-help">
            <summary>搜索用法</summary>

            <div class="search-help-panel">
                <p>普通搜索：直接输入文章标题中的关键词。</p>
                <p>多个关键词：用分号分隔，中英皆可，例如 <code>内存;取证</code>。</p>
                <p>搜索标签：例如 <code>#T内存#</code>。</p>
                <p>搜索题目：例如 <code>#Q流量#</code>。</p>
            </div>
        </details>
    </div>

    <div class="catalog-title" id="catalog-title" data-titles={JSON.stringify(titles)}>
        {titles[defaultIndex] ?? ""}
    </div>
</header>

<script>
    import { EventName as EN } from "@/utils/Common/Event";

    (() =>
    {
        const titleEl = document.getElementById("catalog-title");
        if (!titleEl) return;

        const titles: string[] = JSON.parse(titleEl.dataset.titles ?? "[]");
        if (titles.length === 0) return;

        document.addEventListener(EN.WP_CAT_SWITCH_EVENT, (e: Event) =>
        {
            if (!(e instanceof CustomEvent)) return;

            const detail = e.detail as { counter?: number };
            if (typeof detail.counter !== "number") return;

            const index = detail.counter % titles.length;
            titleEl.textContent = titles[index] ?? "";

            document.dispatchEvent(new CustomEvent(EN.WP_CAT_TITLE_COMPLETED_EVENT));
        });
    })();
</script>

<style>
    .catalog-hero
    {
        /* 2. 盒模型 - 尺寸与排列 */
        width: 100%;
    }

    .catalog-search-guide
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 5000;

        /* 2. 盒模型 - 尺寸与排列 */
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        width: 35vw;
        max-width: 100%;

        /* 3. 盒模型 - 间距 */
        margin: 0 auto 0.75rem;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.6);
        font-size: 0.875rem;
    }

    .search-help
    {
        /* 1. 布局定位 */
        position: relative;

        /* 2. 盒模型 - 尺寸与排列 */
        flex-shrink: 0;
    }

    .search-help summary
    {
        /* 6. 文字 */
        color: #c9bdff;

        /* 9. 交互 */
        cursor: pointer;
    }

    .search-help-panel
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 100%;
        right: 0;

        /* 2. 盒模型 - 尺寸与排列 */
        width: min(28rem, calc(100vw - 2rem));
        max-height: 40vh;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        margin-top: 0.5rem;
        padding: 0.75rem 1rem;

        /* 4. 边框圆角 */
        border: 1px solid rgba(154, 138, 255, 0.3);
        border-radius: 0.75rem;

        /* 5. 背景与阴影 */
        background-color: #1f1e33;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        line-height: 1.6;

        /* 8. 溢出滚动 */
        overflow-y: auto;
    }

    .search-help-panel p
    {
        /* 3. 盒模型 - 间距 */
        margin: 0.5rem 0;
    }

    .catalog-title
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 4000;

        /* 2. 盒模型 - 尺寸与排列 */
        display: block;
        width: fit-content;
        max-width: 100%;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        margin: 0 auto;
        padding: 0.75rem 2rem;

        /* 4. 边框圆角 */
        border-radius: 100px;

        /* 5. 背景与阴影 */
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.3rem;
        font-weight: 700;
        text-align: center;
        word-break: break-word;

        /* 7. 视觉效果 */
        backdrop-filter: blur(4px);
    }
</style>

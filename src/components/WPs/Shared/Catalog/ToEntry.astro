---
import { Common as C } from "@/utils/Common/Common.ts"

import PC from "@/components/WPs/Shared/Catalog/PreviewCard.astro"

import type { WPFrontmatter } from "@/utils/Common/Type"

interface Props
{
    id?: string;
    href: string;
    text: string;
    level?: number;
    data?: WPFrontmatter;
    showPreview?: boolean; 
}


const { id = "0", href = "/", text = "...", level = 0, data, showPreview = true } = Astro.props;

---

<a id={id} class="entry-link" href={href} style={`padding-left: ${(level * C.WP_CAT_LEVEL_INDENT_PX + 10) / 16}rem`}>
    <span class="entry-text">
        <span aria-hidden="true">
            📄-
        </span>

        {text}
    </span>
</a>

{showPreview && data && <PC id={id} data={data} />}




<style>
    /* ---------- 1. 链接基础样式 ---------- */

    .entry-link
    {
        /* 1. 布局定位 */
        position: relative;

        /* 2. 盒模型 - 尺寸与排列 */
        display: block;

        /* 3. 盒模型 - 间距 */
        margin: 0.1rem 0;
        padding: 0.25rem 0;

        /* 4. 边框圆角 */
        border-radius: 8px;

        /* 6. 文字 */
        color: rgba(224, 225, 204, 0.8);
        font-family: "Courier New", "Fira Code", monospace;
        font-size: 0.95rem;
        line-height: 1.6;
        text-decoration: none;
        white-space: normal;
        word-break: break-word;

        /* 10. 动画过渡 */
        transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
    }

    /* ---------- 2. 链接悬停效果 ---------- */

    .entry-link:hover
    {
        /* 5. 背景与阴影 */
        background-color: rgba(255, 255, 255, 0.08);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);

        /* 6. 文字 */
        color: #ffffff;
        text-decoration: underline;
        text-underline-offset: 0.25rem;
        text-decoration-thickness: 2px;
        text-decoration-color: #9a8aff;
    }

    /* ---------- 3. 文字本身 ---------- */

    .entry-text
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: inline;
    }
</style>
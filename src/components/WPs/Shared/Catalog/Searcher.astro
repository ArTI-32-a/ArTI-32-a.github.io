---
export interface Props
{
    placeholder?: string;
}

const { placeholder = "搜索..." } = Astro.props;
---

<div class="catalog-search" id="catalog-search">
    <div class="search-mirror" id="search-mirror" aria-hidden="true">
    </div>

    <input
        type="text"
        class="catalog-search-input"
        id="catalog-search-input"
        placeholder={placeholder}
        autocomplete="off"
    />

    <div class="search-results" id="search-results" hidden>

    </div>
</div>

<script>
    import { EventName as EN } from "@/utils/Common/Event"; 
    import { Common as C } from "@/utils/Common/Common";
    import { importConfig, importDocs, search } from "@/utils/Searching/SearchContribution";

    import type { SearchDocument, FieldConfig, MatchResult } from "@/utils/Searching/CoreContribution";

    interface CatalogNode
    {
        key: string;
        href: string | null;
        data: Record<string, unknown> | null;
        children: CatalogNode[] | null;
    }


    const COLLECTIONS: string[] = ["CTF", "DF"];

    async function loadDocs(): Promise<SearchDocument[]>
    {
        const all: SearchDocument[] = [];

        for (const name of COLLECTIONS)
        {
            const [catalogRes, questionsRes] = await Promise.all([
                fetch(`/data/${name}/catalog.json`),
                fetch(`/data/${name}/questions.json`),
            ]);

            if (!catalogRes.ok || !questionsRes.ok) continue;

            const tree: CatalogNode[] = await catalogRes.json();
            const questionsMap: Record<string, string[] | undefined> = await questionsRes.json();

            flatten(tree, name, questionsMap, all);
        }

        return all;
    }

    function flatten(
        nodes: CatalogNode[],
        collectionName: string,
        questionsMap: Record<string, string[] | undefined>,
        out: SearchDocument[],
    ): void
    {
        const prefix: string = `/wps/${collectionName}/`;

        for (const node of nodes)
        {
            if (node.href && node.data)
            {
                const key: string = node.href.startsWith(prefix)
                    ? node.href.substring(prefix.length)
                    : "";

                const doc: SearchDocument = {
                    href: node.href,
                    title: typeof node.data.title === "string" ? node.data.title : "",
                    tags: Array.isArray(node.data.tags) ? node.data.tags as string[] : [],
                    status: node.data.status === "draft" ? "draft" : "published",
                    pubDate: typeof node.data.pubDate === "string"
                        ? new Date(node.data.pubDate)
                        : undefined,
                };

                const q = questionsMap[key];
                if (q)
                {
                    doc.questions = q;
                }

                out.push(doc);
            }

            if (node.children)
            {
                flatten(node.children, collectionName, questionsMap, out);
            }
        }
    }

    const SEARCH_CONFIG: FieldConfig[] =
    [
        { field: "title", kind: "str", canOccupy: false },
        { field: "tags", kind: "element", formatChar: "T" },
        { field: "questions", kind: "element", formatChar: "Q" },
    ];

    let docsCache: SearchDocument[] | null = null;
    let docsByHref: Map<string, SearchDocument> | null = null;


    async function ensureDocs(): Promise<void>
    {
        if (docsCache !== null) return;
        docsCache = await loadDocs();
        docsByHref = new Map(docsCache.map(d => [d.href, d]));
        importDocs(() => docsCache!);
    }

    importConfig(SEARCH_CONFIG);
    ensureDocs();

    async function runSearch(query: string): Promise<void>
    {
        await ensureDocs();
        const results = search(query, false, true);
        // console.log("[search]", query, results);
        // console.log("1");
        renderResults(results);
    }




    function escapeHtml(s: string): string
    {
        return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    function renderMirror(value: string): string
    {
        // console.log("run!");

        let result: string = "";
        let i: number = 0;
        let inTag: boolean = false;
        let tagBuf: string = "";

        while (i < value.length)
        {
            // console.log("while!");
            const ch: string = value[i];

            // 转义
            if (ch === "\\" && i + 1 < value.length)
            {
                const next: string = escapeHtml(value[i + 1]);
                if (inTag) tagBuf += next;
                else result += next;
                i += 2;
                continue;
            }

            // #
            if (ch === "#")
            {
                // console.log("#!");
                if (inTag)
                {
                    // 关闭当前 tag
                    // result += `<span class="tag-box">${tagBuf}</span>`;
                    // result += `<span class="hidden">#</span>`;
                    // tagBuf = "";
                    // inTag = false;

                    const html: string = `<span class="tag-box">${tagBuf}</span>`;
                    console.log("生成 tag-box:", JSON.stringify(html));
                    result += html;
                    result += `<span class="hidden">#</span>`;
                    tagBuf = "";
                    inTag = false;
                }
                else
                {
                    // 开启 tag
                    result += `<span class="hidden">#</span>`;
                    inTag = true;
                }
                i++;
                continue;
            }

            if (inTag) tagBuf += escapeHtml(ch);
            else result += escapeHtml(ch);
            i++;
        }

        // 结尾还在 tag 内
        if (inTag)
        {
            result += `<span class="tag-box">${tagBuf}</span>`;
        }

        return result;
    }



    function setExpanded(expanded: boolean): void
    {
        const wrap = document.getElementById("catalog-search");
        if (wrap instanceof HTMLElement)
        {
            wrap.classList.toggle("expanded", expanded);
        }
    }

    function renderResults(results: Record<string, MatchResult>): void
    {
        const resultsEl = document.getElementById("search-results");
        if (!(resultsEl instanceof HTMLElement)) return;
        if (!docsByHref) return;

        const entries: Array<[string, MatchResult]> = Object.entries(results)
            .sort(([, a], [, b]) => b.totalScore - a.totalScore);

        if (entries.length === 0)
        {
            resultsEl.hidden = true;
            resultsEl.innerHTML = "";
            setExpanded(false);
            return;
        }

        const max = C.SEARCH_MAX_RESULTS;
        const shown = entries.slice(0, max);
        const moreCount = entries.length - shown.length;

        resultsEl.innerHTML = "";

        for (const [href, score] of shown)
        {
            const doc = docsByHref.get(href);
            if (!doc) continue;

            const collection = href.split("/")[2] ?? "";

            const item = document.createElement("div");
            item.className = "search-result-item";

            const line1 = document.createElement("div");
            line1.className = "search-result-line1";
            line1.textContent = `${collection} / ${doc.title}`;

            const line2 = document.createElement("div");
            line2.className = "search-result-line2";

            const tagsEl = document.createElement("span");
            tagsEl.className = "search-result-tags";
            tagsEl.textContent = doc.tags.join(", ");

            const scoreEl = document.createElement("span");
            scoreEl.className = "search-result-score";
            scoreEl.textContent = score.totalScore.toFixed(3);

            const link = document.createElement("a");
            link.className = "search-result-link";
            link.href = href;
            link.setAttribute("aria-label", `${collection} / ${doc.title}`);

            line2.appendChild(tagsEl);
            line2.appendChild(scoreEl);

            item.appendChild(line1);
            item.appendChild(line2);
            item.appendChild(link);
            resultsEl.appendChild(item);
        }

        if (moreCount > 0)
        {
            const more = document.createElement("div");
            more.className = "search-result-more";
            more.textContent = `还有 ${moreCount} 条`;
            resultsEl.appendChild(more);
        }

        resultsEl.hidden = false;
        setExpanded(true);
    }



    (() =>
    {
        const inputEl = document.getElementById("catalog-search-input");
        if (!(inputEl instanceof HTMLInputElement)) return;

        const mirrorEl = document.getElementById("search-mirror");
        if (!(mirrorEl instanceof HTMLElement)) return;

        const input = inputEl;
        const mirror = mirrorEl;

        let debounceTimer: ReturnType<typeof setTimeout> | null = null;

        let syncRafId: number | null = null;

        function startSyncLoop(): void
        {
            if (syncRafId !== null) return;

            function loop(): void
            {
                mirror.scrollLeft = input.scrollLeft;
                syncRafId = requestAnimationFrame(loop);
            }
            syncRafId = requestAnimationFrame(loop);
        }

        function stopSyncLoop(): void
        {
            if (syncRafId !== null)
            {
                cancelAnimationFrame(syncRafId);
                syncRafId = null;
            }
        }

        input.addEventListener("input", () =>
        {
            const query = input.value;
            

            mirror.innerHTML = renderMirror(query);


            if (debounceTimer !== null)
            {
                clearTimeout(debounceTimer);
            }
            debounceTimer = setTimeout(() =>
            {
                debounceTimer = null;

                // 空输入：不搜索、不清结果
                if (query.trim() === "")
                {
                    return;
                }

                document.dispatchEvent(new CustomEvent(EN.WP_CAT_SEARCH_EVENT, 
                {
                    detail: { query: input.value },
                }));

                runSearch(query);
            }, C.SEARCH_DEBOUNCE_MS);
        });

        input.addEventListener("focus", startSyncLoop);

        input.addEventListener("blur", stopSyncLoop);

        input.addEventListener("keydown", (e: KeyboardEvent) =>
        {
            if (e.key === "Escape")
            {
                const resultsEl = document.getElementById("search-results");
                if (resultsEl instanceof HTMLElement)
                {
                    resultsEl.hidden = true;
                    setExpanded(false);
                }
            }
        });

        document.addEventListener("click", (e: MouseEvent) =>
        {
            const wrap = document.getElementById("catalog-search");
            if (!(wrap instanceof HTMLElement)) return;
            if (!(e.target instanceof Node)) return;
            if (wrap.contains(e.target)) return;

            const resultsEl = document.getElementById("search-results");
            if (resultsEl instanceof HTMLElement)
            {
                resultsEl.hidden = true;
                setExpanded(false);
            }
        });
    })();
</script>

<style>
    .catalog-search
    {
        position: relative;
        z-index: 10000;

        /* 2. 盒模型 - 尺寸 */
        display: block;
        width: 35vw;
        max-width: 100%;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        margin: 0 auto 1rem;
        padding: 0;
    }

    /* ★ 新增：镜像层，和 textarea 完全重叠 */
    .search-mirror
    {
        position: absolute;
        top: 0;
        left: 0;
        z-index: 11000;

        width: 100%;
        max-width: 100%;
        box-sizing: border-box;

        padding: 0.625rem 1.25rem;

        border-radius: 20px;
        border: 1px solid transparent;    /* 和 textarea 的 1px 对齐 */

        color: #ffffff;
        font-size: 1rem;
        font-family: "Segoe UI", "PingFang SC", sans-serif;
        line-height: 1.5;
        white-space: nowrap;      /* ★ 不换行，和 input 一致 */
        word-break: break-word;

        pointer-events: none;
    }

    .catalog-search-input
    {
        /* 2. 盒模型 - 尺寸 */
        position: relative;              /* ★ 新增 */
        display: block;
        width: 100%;
        max-width: 100%;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 0.625rem 1.25rem;

        /* 4. 边框圆角 */
        border-radius: 100px;
        border: 1px solid rgba(154, 138, 255, 0.25);
        outline: none;

        /* 5. 背景 */
        background-color: rgba(0, 0, 0, 0.4);
        backdrop-filter: blur(6px);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: transparent;              /* ★ 改：文字透明，让镜像层显示 */
        caret-color: #ffffff;            /* ★ 新增：光标白色 */
        font-size: 1rem;
        font-family: "Segoe UI", "PingFang SC", sans-serif;
        line-height: 1.5;                /* ★ 新增：保证和镜像层一致 */

        /* 9. 交互 */
        user-select: text;
        -webkit-user-select: text;

        /* 10. 动画过渡 */
        transition: border-radius 0.15s ease, border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
        /* transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease; */
    }

    .catalog-search-input::placeholder
    {
        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.4);
    }

    .catalog-search-input:focus
    {
        /* 4. 边框圆角 */
        border-color: rgba(154, 138, 255, 0.6);

        /* 5. 背景 */
        background-color: rgba(0, 0, 0, 0.55);
        box-shadow:
            0 4px 20px rgba(0, 0, 0, 0.4),
            0 0 12px rgba(154, 138, 255, 0.35);
    }

    /* ★ 新增：# 隐形占位 */
    .search-mirror :global(.hidden)
    {
        visibility: hidden;
    }

    /* ★ 新增：tag 的框 */
    .search-mirror :global(.tag-box)
    {
        display: inline-block;
        /* transform: scale(0.9); */
        /* transform-origin: left center; */
        padding: 0.125rem 0;

        background-color: rgba(154, 138, 255, 0.2);
        border-radius: 400px;
        box-shadow: 0 0 0 1px rgba(154, 138, 255, 0.6);
        color: #d0c8ff;
    }

    .catalog-search.expanded .catalog-search-input
    {
        border-radius: 20px 20px 0 0;
        /* 底部去掉边框，让结果框接着 */
        border-bottom-color: transparent;
    }

    /* 镜像层同步 */
    .catalog-search.expanded .search-mirror
    {
        border-radius: 20px 20px 0 0;
    }

    .search-results
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        z-index: 9999;

        /* 2. 盒模型 - 尺寸 */
        max-height: 40vh;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        margin-top: -1px;   /* 和搜索框边框重叠 1px，看不出接缝 */
        padding: 0;

        /* 4. 边框圆角 */
        border-radius: 0 0 20px 20px;

        /* 5. 背景：和 focus 后的搜索框一样 */
        background-color: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(154, 138, 255, 0.6);
        border-top: none;
        box-shadow:
            0 4px 20px rgba(0, 0, 0, 0.4),
            0 0 12px rgba(154, 138, 255, 0.35);

        /* 字体 */
        color: rgba(224, 225, 204, 0.8);
        font-family: "Courier New", "Fira Code", monospace;

        /* 8. 溢出滚动 */
        overflow-y: auto;
        scrollbar-width: none;
    }

    .search-results::-webkit-scrollbar
    {
        display: none;
    }

    .search-results[hidden]
    {
        display: none;
    }

    .search-results :global(.search-result-item)
    {
        /* 1. 布局定位 */
        position: relative;    /* ← 加这行 */

        /* 3. 盒模型 - 间距 */
        padding: 0.6rem 1rem;

        /* 4. 边框圆角 */
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transition: background-color 0.15s ease;
    }

    .search-results :global(.search-result-item:last-of-type)
    {
        border-bottom: none;
    }

    .search-results :global(.search-result-item:hover)
    {
        background-color: rgba(154, 138, 255, 0.15);
    }

    .search-results :global(.search-result-line1)
    {
        color: #ffffff;
        font-size: 0.95rem;
        line-height: 1.4;
        word-break: break-word;
    }

    .search-results :global(.search-result-line2)
    {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 1rem;
        margin-top: 0.2rem;

        color: rgba(255, 255, 255, 0.5);
        font-size: 0.8rem;
        line-height: 1.4;
        word-break: break-word;
    }

    .search-results :global(.search-result-tags)
    {
        flex: 1;
        min-width: 0;
    }

    .search-results :global(.search-result-score)
    {
        flex-shrink: 0;
        color: rgba(154, 138, 255, 0.8);
        font-family: "Courier New", monospace;
    }

    .search-results :global(.search-result-more)
    {
        padding: 0.5rem 1rem;
        color: rgba(255, 255, 255, 0.4);
        font-size: 0.8rem;
        text-align: center;
        font-style: italic;
    }

    .search-results :global(.search-result-link)
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;
        z-index: 1;

        /* 4. 边框圆角 */
        border-radius: inherit;

        /* 7. 视觉效果 */
        /* 完全透明，只用来接收点击 */

        /* 9. 交互 */
        cursor: pointer;

        /* 6. 文字 */
        text-decoration: none;
    }
</style>

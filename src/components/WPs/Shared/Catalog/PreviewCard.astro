---
function isWPFormatter(data: unknown): data is WPFrontmatter
{
    if (typeof data !== "object" || data === null) return false;

    if (!("title" in data) || typeof data.title !== "string") return false;

    if (!("tags" in data) || !Array.isArray(data.tags)) return false;
    for (const tag of data.tags)
    {
        if (typeof tag !== "string") return false;
    }

    // 有 type 就是 CTF，没有就是 DF，两边都允许
    if ("type" in data && data.type !== undefined)
    {
        if (typeof data.type !== "string") return false;
        const allowed = ["Misc", "Crypto", "Reverse", "Web", "PWN", "Digit Safety"];
        if (!allowed.includes(data.type)) return false;
    }

    if (!("status" in data) || typeof data.status !== "string") return false;
    if (data.status !== "draft" && data.status !== "published") return false;

    return true;
}


import type { WPFrontmatter } from "@/utils/Common/Type";

interface Props 
{
    id: string,
    data: WPFrontmatter | undefined,
}
const { id = "000" , data } = Astro.props;

if (!isWPFormatter(data))
{
    throw new Error("data is not instance of ConData");
}
---


<div id={`preview-${id}`} class="preview-card">
    <div class="preview-tags">
        {data?.tags?.map(tag => <span class="tag">{tag}</span>)}
    </div>
    
    <div class="preview-title">
        {data?.questions && data.questions.length > 0
            ? data.questions.map(que => <div class="preview-title-item">{que}</div>)
            : "这里空空如也喵~"
        }
    </div>
</div>


<script define:vars={{ id, data }} lang="ts">
    (() => 
    {
        const CARD_OFFSET = 0.9375; // rem

        const btn = document.getElementById(id);
        const preview = document.getElementById(`preview-${id}`);

        if (!btn || !preview)
        {
            console.warn("href and preview cannot be found");
            return;
        }

        let timer = null;
        let pointerX = 0;
        let pointerY = 0;

        function positionPreview()
        {
            const rootFontSize = parseFloat(getComputedStyle(document.documentElement).fontSize);
            const gap = CARD_OFFSET * rootFontSize;
            const rect = preview.getBoundingClientRect();
            let left = pointerX + gap;
            let top = pointerY + gap;

            if (left + rect.width > window.innerWidth - gap)
            {
                left = pointerX - rect.width - gap;
            }
            if (top + rect.height > window.innerHeight - gap)
            {
                top = pointerY - rect.height - gap;
            }

            left = Math.max(gap, Math.min(left, window.innerWidth - rect.width - gap));
            top = Math.max(gap, Math.min(top, window.innerHeight - rect.height - gap));
            preview.style.left = `${left / window.innerWidth * 100}vw`;
            preview.style.top = `${top / window.innerHeight * 100}vh`;
        }

        btn.addEventListener("mouseenter", (e) =>
        {
            pointerX = e.clientX;
            pointerY = e.clientY;
            timer = window.setTimeout(() => 
            {
                preview.style.display = "block";
                positionPreview();
            }, 100);
        });

        btn.addEventListener("mouseleave", () => 
        {
            if (timer !== null)
            {
                window.clearTimeout(timer);
                timer = null;
            }

            preview.style.display = "none";
        });

        btn.addEventListener("mousemove", (e) => 
        {
            pointerX = e.clientX;
            pointerY = e.clientY;
            if (preview.style.display === "block") positionPreview();
        });
    })();

</script>


<style>
    /*
        ---------- 1. 浮动卡片 ----------
    */
    .preview-card
    {
        /* 1. 布局定位 */
        position: fixed;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸 */
        display: none;
        max-width: min(20vw, calc(100vw - 1.875rem));
        max-height: min(25vh, calc(100vh - 1.875rem));
        box-sizing: border-box;
        overflow: auto;

        /* 3. 盒模型 - 间距 */
        padding: 0.5rem 0.75rem;

        /* 4. 边框圆角 */
        border-radius: 8px;

        /* 5. 背景 */
        background-color: rgba(20, 20, 40, 0.95);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.6);

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.9);
        font-family: "Segoe UI", sans-serif;
        font-size: 0.85rem;
        line-height: 1.5;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transition: opacity 0.15s ease;
    }

    /*
        ---------- 2. 标签容器 ----------
    */
    .preview-tags
    {
        /* 2. 盒模型 - 尺寸 */
        display: flex;
        flex-wrap: wrap;

        /* 3. 盒模型 - 间距 */
        gap: 0.25rem;
        margin-bottom: 0.25rem;
    }

    /*
        ---------- 3. 单个标签 ----------
    */
    .tag
    {
        /* 3. 盒模型 - 间距 */
        padding: 0.125rem 0.375rem;

        /* 4. 边框圆角 */
        border-radius: 4px;

        /* 5. 背景 */
        background-color: rgba(154, 138, 255, 0.2);

        /* 6. 文字 */
        color: #9a8aff;
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.03em;
    }

    /*
        ---------- 4. 标题 ----------
    */
    .preview-title
    {
        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        word-break: break-word;
    }

    /*
        ---------- 单个标题项 ----------
    */
    .preview-title-item
    {
        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        font-weight: 500;
        word-break: break-word;
        line-height: 1.6;
    }
</style>

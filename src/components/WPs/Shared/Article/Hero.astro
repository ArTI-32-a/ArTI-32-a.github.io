---
import type { ImageMetadata, MarkdownHeading } from "astro";
import { buildBackground } from "@/utils/Common/Background/Builder";
import { getArticleBreadcrumb } from "@/utils/WPs/Breadcrumb";

import type { WPFrontmatter, WPInfo } from "@/utils/Common/Type";

import C from "@/components/WPs/Shared/Catalog.astro"
import BC from "@/components/Shared/Breadcrumb/Breadcrumb.astro";

export interface Props
{
    data: WPFrontmatter;
    headings: MarkdownHeading[];
    backgroundImage: ImageMetadata;
    treeInfo: WPInfo[];
    shrinkOffset?: number;  
    collectionName: string; 
}

const { data, headings, backgroundImage, treeInfo, shrinkOffset = 0, collectionName = "" } = Astro.props;

const background = await buildBackground(backgroundImage);

const tree = treeInfo ?? [];
const breadcrumbs = getArticleBreadcrumb(
{
    tree,
    pathname: Astro.url.pathname,
    collectionName,
    articleTitle: data.title,
});

let minDepth = Infinity;
for (const h of headings)
{
    if (h.depth >= 2 && h.depth < minDepth)
    {
        minDepth = h.depth;
    }
}

const topHeadings = (minDepth === Infinity ? [] : headings.filter(h => h.depth === minDepth));
---

<header 
    class="hero" 
    id="hero" 
    data-background-variants={JSON.stringify(background.variants)}
    data-background-aspect={background.aspect}
    style={`--hero-shrink-offset: ${shrinkOffset}vh;`}
>
    <div class="hero-breadcrumb">
        <BC items={breadcrumbs} separator=">>" />
    </div>

    <div class="hero-content">
        <div class="title-box">
            {data.title}
        </div>
        


        <div class="hero-columns">
            <div class="hero-left">
                <C tree={tree} compact={true} collectionName={collectionName} />
            </div>

            <div class="meta-block">
                <div class="type-tags">
                    {data.type && `${data.type} : `}{data.tags.join(" ")}
                </div>
                <div class="heading-links">
                    {topHeadings.map(h => (
                        <a href={`#${h.slug}`} class="heading-link">
                            {h.text}
                        </a>
                    ))}
                </div>
            </div>

            <div class="hero-right">

            </div>
        </div>
    </div>
</header>



<script>
    import { loadBackground, type BackgroundVariant } from "@/utils/Common/Background/Loader";

    const hero = document.getElementById("hero");

    if (hero instanceof HTMLElement) 
    {
        const variants: BackgroundVariant[] = JSON.parse(
            hero.dataset.backgroundVariants ?? "[]"
        );

        void loadBackground(
            hero,
            variants,
            Number(hero.dataset.backgroundAspect),
            {
                maxPixelRatio: 2,
            }
        );
    }
</script>



<style>
    .hero
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸与排列 */
        width: 100%;
        height: 60vh;

        /* 5. 背景与阴影 */
        background-color: rgba(154, 138, 255, 1);
        background-position: center 20%;
        background-size: cover;
        background-repeat: no-repeat;

        /* 8. 溢出滚动 */
        overflow: hidden;

        /* 10. 动画过渡 */
        transition: background-position 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .hero.shrink
    {
        /* 5. 背景与阴影 */
        background-position: center calc(calc(20% + var(--hero-shrink-offset, -5vh)));
    }

    .hero-breadcrumb
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 1rem;
        left: 5%;
        z-index: 10;

        /* 2. 盒模型 - 尺寸与排列 */
        /* width: 90%; */
        width: fit-content;
        max-width: 90%;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 0.5rem 0.75rem;

        /* 4. 边框圆角 */
        border-radius: 0.5rem;

        /* 5. 背景与阴影 */
        background-color: rgba(20, 20, 40, 0.65);
    }

    .hero-content
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 50%;
        left: 50%;

        /* 2. 盒模型 - 尺寸与排列 */
        width: 90%;
        max-width: 100%;
        box-sizing: border-box;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    .title-box
    {
        /* 1. 布局定位 */
        position: relative;
        z-index: 5;

        /* 2. 盒模型 - 尺寸与排列 */
        display: block;
        width: fit-content;
        max-width: 100%;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        margin: 0 auto;
        padding: 0.75rem 2rem;

        /* 4. 边框圆角 */
        border-radius: 100px;

        /* 5. 背景与阴影 */
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.3rem;
        font-weight: 700;
        text-align: center;
        word-break: break-word;

        /* 7. 视觉效果 */
        backdrop-filter: blur(4px);

        /* 10. 动画过渡 */
        transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    /* 对接mask的 */

    .title-box.shrink
    {
        /* 10. 动画过渡 */
        transform: translateY(-5vh);
    }

    .hero-columns
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: start;
        gap: 2rem;
        min-width: 0;
        height: 30vh;

        /* 3. 盒模型 - 间距 */
        margin-top: 1.5rem;

        /* 10. 动画过渡 */
        transition: transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1),
            opacity 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);
    }

    .hero-columns.shrink
    {
        /* 7. 视觉效果 */
        opacity: 0;

        /* 10. 动画过渡 */
        transform: translateY(-5vh);
    }

    .hero-left
    {
        /* 高度由父级 .hero-columns 决定。 */

        /* 2. 盒模型 - 尺寸与排列 */
        width: 100%;
        height: 100%;
        min-width: 0;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 1rem 1.5rem;

        /* 4. 边框圆角 */
        border-radius: 12px;
        border: 1px solid rgba(154, 138, 255, 0.15);

        /* 5. 背景与阴影 */
        background-color: rgba(0, 0, 0, 0.4);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        text-indent: 2em;

        /* 7. 视觉效果 */
        backdrop-filter: blur(6px);

        /* 8. 溢出滚动 */
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .meta-block
    {
        /* 2. 盒模型 - 尺寸与排列 */
        width: 100%;
        height: 100%;
        min-width: 0;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 1rem 1.5rem;

        /* 4. 边框圆角 */
        border-radius: 12px;
        border: 1px solid rgba(154, 138, 255, 0.15);

        /* 5. 背景与阴影 */
        background-color: rgba(0, 0, 0, 0.4);
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        text-indent: 2em;

        /* 7. 视觉效果 */
        backdrop-filter: blur(6px);

        /* 8. 溢出滚动 */
        overflow-y: auto;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .hero-left::-webkit-scrollbar,
    .meta-block::-webkit-scrollbar,
    .hero-right::-webkit-scrollbar
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: none;
    }

    .type-tags
    {
        /* 3. 盒模型 - 间距 */
        margin-bottom: 1rem;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.9rem;
        line-height: 1.6;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .heading-links
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: block;
    }

    .heading-link
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: block;

        /* 3. 盒模型 - 间距 */
        padding: 0.15rem 0;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.75);
        text-decoration: none;
        font-size: 0.9rem;
        line-height: 1.6;
        word-break: break-word;
        overflow-wrap: break-word;

        /* 10. 动画过渡 */
        transition: color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .heading-link:hover
    {
        /* 5. 背景与阴影 */
        background-color: rgba(154, 138, 255, 0.12);
        box-shadow: inset 0 0 12px rgba(154, 138, 255, 0.3),
            0 0 12px rgba(154, 138, 255, 0.45),
            0 0 24px rgba(154, 138, 255, 0.2);

        /* 6. 文字 */
        color: #9a8aff;
        text-decoration: underline;
        text-underline-offset: 0.1875rem;
        text-decoration-color: rgba(154, 138, 255, 0.6);
        text-decoration-thickness: 1px;
        white-space: normal;

        /* 10. 动画过渡 */
        transform: translateX(0.25rem);
    }
</style>

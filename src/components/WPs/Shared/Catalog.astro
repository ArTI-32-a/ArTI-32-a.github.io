---
import { Common as C } from "@/utils/Common/Common"

import type { JSX } from "astro/jsx-runtime";

import type { WPInfo } from "@/utils/Common/Type";
import ToEntry from "@/components/WPs/Shared/Catalog/ToEntry.astro";

export interface Props
{
    tree: WPInfo[];
    compact?: boolean;
    collectionName: string;
}

const { tree, compact = false, collectionName = "" } = Astro.props;

let idNum: number = 4900;
---


<article class:list={["wp-catalog", { compact }]}>
    {(() =>
    {
        function renderTree(nodes: WPInfo[], level: number = 0): JSX.Element[]
        {
            return nodes.map((node: WPInfo) =>
            {
                if (node.href)
                {
                    idNum += 100;
                    return (<ToEntry 
                        id={`${collectionName}-${idNum}`} 
                        href={node.href} 
                        text={node.data?.title ?? node.key} 
                        level={level} 
                        data={node.data ?? undefined} 
                        showPreview={!compact}/>);
                }

                else
                {
                    return (
                        <div class="wp-folder" style={`padding-left: ${level * C.WP_CAT_BTN_PADDING / 16}rem`}>
                            <div class={`wp-folder-title level-${level >= 3 ? "else" : level}`}>
                                {node.key}
                            </div>
                        </div>
                        <div>
                            {node.children && node.children.length > 0 && renderTree(node.children, level + 1)}
                        </div>
                    );
                }
            });
        }

        return renderTree(tree, 0);
    })()}
</article>


<style>
    /*
        ---------- 1. 容器 ----------
    */
    .wp-catalog
    {
        display: block;
        width: 100%;
        max-width: 60vw;
        box-sizing: border-box;
        margin: 0 auto;
        padding: 2rem;
        background-color: transparent;
    }

    .wp-catalog.compact
    {
        max-width: none;
        margin: 0;
        padding: 0;
    }

    /*
        ---------- 2. 文件夹标题 ----------
    */
    .wp-folder-title
    {
        color: rgba(255, 255, 255, 0.85);
        font-family: "Segoe UI", "PingFang SC", sans-serif;
        letter-spacing: 0.03em;
        padding: 0.25rem 0;
        cursor: default;
        user-select: none;
    }

    .wp-folder
    {
        margin: 0.1rem 0;
    }

    /*
        ---------- 3. 文件夹层级样式 ----------
    */
    .level-0
    {
        font-size: 1.4rem;
        font-weight: 700;
        color: #9a8aff;
    }
    .level-1
    {
        font-size: 1.15rem;
        font-weight: 600;
        color: #b8aeff;
    }
    .level-2
    {
        font-size: 1rem;
        font-weight: 500;
        color: #d0c8ff;
    }
    .level-else
    {
        font-size: 1rem;
        font-weight: 600;
        color: rgba(172, 185, 244, 0.7);
    }
</style>

---
---

<button class="info-entry" id="info-entry" type="button" aria-label="探索本站 · 关于我" aria-controls="contact-menu" title="探索本站 · 关于我">
    <span class="info-entry-fallback" aria-hidden="true">
        ◇
    </span>

    <span class="info-entry-scene" aria-hidden="true">
        
    </span>
</button>

<script>
    import * as THREE from "three";
    import { EventName as EN } from "@/utils/Common/Event";

    (() =>
    {
        const containerEl = document.getElementById("info-entry");
        if (!(containerEl instanceof HTMLButtonElement))
        {
            return;
        }
        const container = containerEl;

        // 入口只发送事件，沿用现有信息菜单的开关逻辑。
        container.addEventListener("click", () =>
        {
            document.dispatchEvent(new CustomEvent(EN.INF_MENU_OPEN_EVENT));
        });

        const sceneEl = container.querySelector(".info-entry-scene");
        if (!(sceneEl instanceof HTMLElement))
        {
            return;
        }
        const sceneContainer = sceneEl;

        let renderer: THREE.WebGLRenderer;
        try
        {
            renderer = new THREE.WebGLRenderer({ alpha: true, antialias: true });
        }
        catch
        {
            // WebGL 不可用时保留菱形入口，仍然可以打开菜单。
            return;
        }

        const scene = new THREE.Scene();
        const camera = new THREE.PerspectiveCamera(40, 1, 0.1, 20);
        camera.position.set(2, 1.5, 4.5);
        camera.lookAt(0, 0, 0);

        const geometry = new THREE.OctahedronGeometry(1.35);
        const material = new THREE.MeshStandardMaterial({
            color: 0x49c9e8,
            emissive: 0x146b86,
            emissiveIntensity: 0.45,
            metalness: 0.35,
            roughness: 0.3,
        });
        const crystal = new THREE.Mesh(geometry, material);
        const edges = new THREE.EdgesGeometry(geometry);
        const edgeMaterial = new THREE.LineBasicMaterial({ color: 0xb9f6ff });
        crystal.add(new THREE.LineSegments(edges, edgeMaterial));
        scene.add(crystal);
        scene.add(new THREE.AmbientLight(0xb9d8ff, 1.5));
        const light = new THREE.DirectionalLight(0xffffff, 3);
        light.position.set(3, 4, 5);
        scene.add(light);

        sceneContainer.appendChild(renderer.domElement);
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let frameId: number | null = null;
        let lastTimestamp: number | null = null;
        let elapsed: number = 0;

        function render(): void
        {
            renderer.render(scene, camera);
        }

        function animate(timestamp: number): void
        {
            const frameFactor = lastTimestamp === null
                ? 0
                : Math.min((timestamp - lastTimestamp) / (1000 / 60), 3);
            lastTimestamp = timestamp;
            elapsed += frameFactor / 60;
            crystal.rotation.x += 0.006 * frameFactor;
            crystal.rotation.y += 0.012 * frameFactor;
            crystal.scale.setScalar(0.94 + Math.sin(elapsed * 2) * 0.06);
            render();
            frameId = requestAnimationFrame(animate);
        }

        function syncAnimation(): void
        {
            if (frameId !== null)
            {
                cancelAnimationFrame(frameId);
                frameId = null;
            }
            lastTimestamp = null;
            if (!document.hidden && !reducedMotion.matches)
            {
                frameId = requestAnimationFrame(animate);
            }
            else
            {
                render();
            }
        }

        const resizeObserver = new ResizeObserver(() =>
        {
            const width = sceneContainer.clientWidth;
            const height = sceneContainer.clientHeight;
            if (width === 0 || height === 0) return;
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            renderer.setSize(width, height);
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            render();
            container.classList.add("ready");
        });
        resizeObserver.observe(sceneContainer);
        document.addEventListener("visibilitychange", syncAnimation);
        reducedMotion.addEventListener("change", syncAnimation);
        // 往返缓存恢复页面时继续动画。
        window.addEventListener("pageshow", syncAnimation);
        window.addEventListener("pagehide", () =>
        {
            if (frameId !== null) cancelAnimationFrame(frameId);
            frameId = null;
            lastTimestamp = null;
        });
        syncAnimation();
    })();
</script>

<style>
    .info-entry
    {
        /* 1. 布局定位 */
        --entry-offset: 4rem;
        position: fixed;
        right: calc(1.5rem + var(--entry-offset));
        bottom: calc(1.5rem + var(--entry-offset));
        z-index: 1001;

        /* 2. 盒模型 - 尺寸与排列 */
        --entry-size: 3rem;
        width: var(--entry-size);
        height: var(--entry-size);

        /* 3. 盒模型 - 间距 */
        padding: 0;

        /* 4. 边框圆角 */
        border: none;
        border-radius: 0.5rem;

        /* 5. 背景与阴影 */
        background: transparent;

        /* 6. 文字 */
        color: #b9f6ff;
        font-size: 2.5rem;

        /* 7. 视觉效果 */
        filter: drop-shadow(0 0 5px rgba(73, 201, 232, 0.45));

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transition: filter 0.2s ease;
    }

    .info-entry:focus-visible
    {
        /* 4. 边框圆角 */
        outline: 2px solid #b9f6ff;
        outline-offset: 0.25rem;
    }

    .info-entry:hover
    {
        /* 7. 视觉效果 */
        filter: drop-shadow(0 0 9px rgba(73, 201, 232, 0.8));
    }

    .info-entry-fallback,
    .info-entry-scene
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;

        /* 2. 盒模型 - 尺寸与排列 */
        display: grid;
        place-items: center;

        /* 9. 交互 */
        pointer-events: none;
    }

    .info-entry.ready .info-entry-fallback
    {
        /* 7. 视觉效果 */
        visibility: hidden;
    }

    .info-entry-scene :global(canvas)
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: block;
        width: 100%;
        height: 100%;
    }
</style>

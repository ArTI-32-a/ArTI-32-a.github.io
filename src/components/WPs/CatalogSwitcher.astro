---
import Catalog from "@/components/WPs/Catalog.astro";

import type { WPInfo } from "@/utils/Common/Type";

import { Common as C } from "@/utils/Common/Common";

export interface TreeEntry
{
    title: string;
    tree: WPInfo[];
}

export interface Props
{
    entries: TreeEntry[];
    defaultIndex?: number;
}

const { entries, defaultIndex = 0 } = Astro.props;
---


<div class="directory-switcher" id="switcher" data-default-index={defaultIndex}>
    {entries.map((entry, i) => (
        <div class="directory-content" data-index={i}>
            {/* <div class="directory-title">{entry.title}</div> */}
            <Catalog tree={entry.tree} />
        </div>
    ))}

    <div class="switcher-beam" id="beam">
        <svg viewBox={`0 0 ${100 * C.WP_CAT_SVG_SCALE} ${100 * C.WP_CAT_SVG_SCALE}`} xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <defs>
                <filter id="beam-glow" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation={0.4 * C.WP_CAT_SVG_SCALE} result="b1" />
                    <feGaussianBlur stdDeviation={1.2 * C.WP_CAT_SVG_SCALE} result="b2" />

                    <feMerge>
                        <feMergeNode in="b2" />
                        <feMergeNode in="b1" />
                        <feMergeNode in="SourceGraphic" />
                    </feMerge>
                </filter>

                <filter id="band-glow" x="-50%" y="-50%" width="200%" height="200%">
                    <feGaussianBlur stdDeviation={2 * C.WP_CAT_SVG_SCALE} />
                </filter>

                <linearGradient id="beam-gradient" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#7acfff" stop-opacity="0" />
                    <stop offset="12%" stop-color="#a0e0ff" stop-opacity="1" />
                    <stop offset="50%" stop-color="#c0f0ff" stop-opacity="1" />
                    <stop offset="88%" stop-color="#a0e0ff" stop-opacity="1" />
                    <stop offset="100%" stop-color="#7acfff" stop-opacity="0" />
                </linearGradient>
            </defs>

            <polygon 
                id="mask-shape" 
                fill="#1f1e33" 
                points=
                {
                    `${C.WP_CAT_BEAM_TOP_X * C.WP_CAT_SVG_SCALE},0 
                    ${500 * C.WP_CAT_SVG_SCALE},0 
                    ${500 * C.WP_CAT_SVG_SCALE},${100 * C.WP_CAT_SVG_SCALE} 
                    ${C.WP_CAT_BEAM_BOTTOM_X * C.WP_CAT_SVG_SCALE},${100 * C.WP_CAT_SVG_SCALE}`
                } 
                style="opacity: 0;" 
            />
            
            <line
                x1={C.WP_CAT_BEAM_TOP_X * C.WP_CAT_SVG_SCALE}
                y1="0"
                x2={C.WP_CAT_BEAM_BOTTOM_X * C.WP_CAT_SVG_SCALE}
                y2={100 * C.WP_CAT_SVG_SCALE}
                stroke="#1f1e33"
                stroke-width={15 * C.WP_CAT_SVG_SCALE}
                style="filter: blur(15vw);"
            />
            
            <line 
                x1={C.WP_CAT_BEAM_TOP_X * C.WP_CAT_SVG_SCALE} 
                y1="0" 
                x2={C.WP_CAT_BEAM_BOTTOM_X * C.WP_CAT_SVG_SCALE} 
                y2={100 * C.WP_CAT_SVG_SCALE} 
                stroke="url(#beam-gradient)" 
                stroke-width={0.5 * C.WP_CAT_SVG_SCALE} 
                filter="url(#beam-glow)" 
            />

            <!-- 命中区：不可见，但会接收指针事件 -->
            <line
                class="beam-hitarea"
                x1={C.WP_CAT_BEAM_TOP_X * C.WP_CAT_SVG_SCALE}
                y1="0"
                x2={C.WP_CAT_BEAM_BOTTOM_X * C.WP_CAT_SVG_SCALE}
                y2={100 * C.WP_CAT_SVG_SCALE}
                stroke="transparent"
                stroke-width={5 * C.WP_CAT_SVG_SCALE}
            />
        </svg>
    </div>

    <div class="switcher-flash" id="flash"></div>
</div>


<script>
    import { Common as C } from "@/utils/Common/Common";

    (() =>
    {
        const switcherEl = document.getElementById("switcher");
        const beamEl = document.getElementById("beam");
        const flashEl = document.getElementById("flash");
        const maskShapeEl = document.getElementById("mask-shape");

        if (!switcherEl || !beamEl || !flashEl || !maskShapeEl) return;

        // 之后用这几个强类型变量
        const switcher: HTMLElement = switcherEl;
        const beam: HTMLElement = beamEl;
        const flash: HTMLElement = flashEl;
        const maskShape: HTMLElement = maskShapeEl;

        const contents = switcher.querySelectorAll(".directory-content");

        let currentIndex: number = Number(switcher.dataset.defaultIndex ?? "0");
        let currentOffset: number = 0;
        let dragStartX: number = 0;
        let isDragging: boolean = false;

        function applyContent(): void
        {
            contents.forEach((el, i) =>
            {
                el.classList.toggle("active", i === currentIndex);
            });
        }

        function applyBeam(offset: number): void
        {
            currentOffset = offset;
            beam.style.transform = `translateX(${offset}px)`;

            if (offset > C.PX_EPSILON)
            {
                maskShape.style.opacity = "1";
            }

            beam.addEventListener("transitionend", (e: TransitionEvent) =>
            {
                console.log(currentOffset);
                if (e.propertyName === "transform" && currentOffset < C.PX_EPSILON)
                {
                    maskShape.style.opacity = "0";
                }
                else if (e.propertyName === "transform")
                {
                    maskShape.style.opacity = "1";
                }
            });
        }

        function isOnBeam(clientX: number, clientY: number): boolean
        {
            const sw = window.innerWidth;
            const sh = window.innerHeight;

            const topX = (C.WP_CAT_BEAM_TOP_X / 100) * sw + currentOffset;
            const bottomX = (C.WP_CAT_BEAM_BOTTOM_X / 100) * sw + currentOffset;

            const t = clientY / sh;
            const lineX = topX + t * (bottomX - topX);

            return Math.abs(clientX - lineX) < C.WP_CAT_ON_BEAM_INTERVAL;
        }

        function onPointerDown(e: PointerEvent): void
        {
            if (isDragging) return;
            if (currentOffset !== 0) return;
            if (!isOnBeam(e.clientX, e.clientY)) return;

            isDragging = true;
            dragStartX = e.clientX;
            beam.classList.add("dragging");
            maskShape.style.opacity = "1";
        }

        function onPointerMove(e: PointerEvent): void
        {
            if (!isDragging) return;

            const sw = window.innerWidth;
            const maxDrag = sw * (C.WP_CAT_BEAM_TOP_X - C.WP_CAT_BEAM_MIN_TOP_X) / 100;

            let dx = e.clientX - dragStartX;
            if (dx > 0) dx = 0;
            if (dx < -maxDrag) dx = -maxDrag;

            applyBeam(dx);
        }

        function onPointerUp(): void
        {
            if (!isDragging) return;
            isDragging = false;
            beam.classList.remove("dragging");

            const sw = window.innerWidth;
            const triggerOffset = -sw * (C.WP_CAT_BEAM_TOP_X - C.WP_CAT_BEAM_TRIGGER_TOP_X) / 100;

            if (currentOffset <= triggerOffset)
            {
                triggerSwitch();
            }
            else
            {
                applyBeam(0);
                // maskShape!.style.opacity = "0";
            }
        }

        function triggerSwitch(): void
        {
            flash!.classList.add("active");

            // flash 到一半时切换内容（此时被白色盖住，看不见）
            setTimeout(() =>
            {
                currentIndex = (currentIndex + 1) % contents.length;
                applyContent();
            }, 200);

            // 内容切好后再让 beam 归位 + mask 淡出（有 transition，会平滑）
            setTimeout(() =>
            {
                applyBeam(0);
                // maskShape!.style.opacity = "0";
            }, 400);

            // flash 动画走完后再移除 class
            setTimeout(() =>
            {
                flash!.classList.remove("active");
            }, 600);
        }

        window.addEventListener("pointerdown", onPointerDown);
        window.addEventListener("pointermove", onPointerMove);
        window.addEventListener("pointerup", onPointerUp);

        applyContent();
        applyBeam(0);
    })();
</script>



<style>
    .directory-switcher
    {
        position: relative;
        width: 100%;
        min-height: 100vh;
    }

    .directory-content
    {
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .directory-content.active
    {
        opacity: 1;
        pointer-events: auto;
    }

    .switcher-beam
    {
        position: fixed;
        inset: 0;
        pointer-events: none;
        transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);

        z-index: 5000;
    }

    .switcher-beam.dragging
    {
        transition: none;
    }

    .switcher-beam svg
    {
        width: 100%;
        height: 100%;
        display: block;
        overflow: visible;
    }

    /* .switcher-beam #mask-shape
    {
        transition: opacity 0.5s ease;
    } */

    .switcher-flash
    {
        position: fixed;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(ellipse at center, rgba(200, 235, 255, 0.95) 0%, rgba(200, 235, 255, 0.6) 25%, rgba(31, 30, 51, 0) 70%);
        
        z-index: 1000000;
    }

    .switcher-flash.active
    {
        animation: flash-pulse 0.4s ease-out;
    }

    @keyframes flash-pulse
    {
        0% { opacity: 0; }
        40% { opacity: 1; }
        100% { opacity: 0; }
    }

    .switcher-beam .beam-hitarea
    {
        pointer-events: stroke;
        cursor: grab;
    }

    .switcher-beam .beam-hitarea:active
    {
        cursor: grabbing;
    }
</style>
---
import type { MarkdownHeading } from "astro";

export interface Props
{
    headings: MarkdownHeading[];
}

interface TocGroup
{
    title: string;
    hasTitle: boolean;      // 是否有可展示的标题（决定是否 sticky）
    headings: MarkdownHeading[];
}

function buildGroups(input: MarkdownHeading[]): TocGroup[]
{
    const groups: TocGroup[] = [];
    let current: TocGroup | null = null;
    let sectionNumberedCount = 0;

    for (const h of input)
    {
        const isSection = h.depth === 2;
        const isNumbered = h.depth === 3 && /^\d+\s*#\s*\S/.test(h.text.trim());

        let startNewGroup = false;
        let newHasTitle = false;

        if (isSection)
        {
            startNewGroup = true;
            newHasTitle = true;
            sectionNumberedCount = 0;
        }
        else if (isNumbered)
        {
            if (!current || !current.hasTitle)
            {
                startNewGroup = true;
                newHasTitle = false;
            }
            else
            {
                sectionNumberedCount++;
                if (sectionNumberedCount > 1)
                {
                    startNewGroup = true;
                    newHasTitle = false;
                }
            }
        }

        if (startNewGroup)
        {
            if (current) groups.push(current);
            current = {
                title: newHasTitle ? h.text : "",
                hasTitle: newHasTitle,
                headings: newHasTitle ? [] : [h],
            };
        }
        else
        {
            if (!current)
            {
                current = {
                    title: "",
                    hasTitle: false,
                    headings: [h],
                };
            }
            else
            {
                current.headings.push(h);
            }
        }
    }

    if (current) groups.push(current);
    return groups;
}

const { headings } = Astro.props;
const groups = buildGroups(headings);
---

<nav class="toc">
    <div class="toc-title">
        Catalog / 目录
    </div>

    <a class="toc-section-link" href="#article-top" data-slug="article-top" data-depth="0">
        正文：
    </a>

    {groups.map(g => (
        <div class:list={["toc-group", g.hasTitle ? "with-title" : ""]}>
            {g.hasTitle && <div class="toc-group-title">{g.title}</div>}
            <ul class="toc-list">
                {g.headings.map(h => (
                    <li class="toc-item">
                        <a
                            href={`#${h.slug}`}
                            class="toc-link"
                            data-slug={h.slug}
                            data-depth={h.depth}
                            style={`padding-left: calc(0.4rem + ${Math.max(0, h.depth - 3) * 1.5}rem);`}
                        >
                            {h.text}
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    ))}

    <a class="toc-section-link" href="#comment-top" data-slug="comment-top" data-depth="0">
        评论：
    </a>
</nav>


<style>
    .toc
    {
        /* 3. 盒模型 - 间距 */
        padding: 0.8rem;
    }

    .toc-title
    {
        /* 1. 布局定位 */
        position: sticky;
        top: 0;
        z-index: 3;

        /* 3. 盒模型 - 间距 */
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;

        /* 4. 边框圆角 */
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);

        /* 5. 背景与阴影 */
        background-color: rgba(31, 30, 51, 0.96);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1rem;
        font-weight: 700;
    }

    .toc-section-link
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: block;

        /* 3. 盒模型 - 间距 */
        margin: 1rem 0 0.75rem;
        padding: 0.25rem 0.5rem;

        /* 4. 边框圆角 */
        border-left: 2px solid rgba(154, 138, 255, 0.5);
        border-radius: 0 0.375rem 0.375rem 0;

        /* 6. 文字 */
        color: #c9bdff;
        font-size: 0.95rem;
        font-weight: 600;
        text-decoration: none;

        /* 10. 动画过渡 */
        transition: color 0.2s ease, background-color 0.2s ease;
    }

    .toc-section-link:focus-visible
    {
        /* 9. 交互 */
        outline: 2px solid #9a8aff;
        outline-offset: 2px;
    }

    .toc-section-link:hover
    {
        /* 5. 背景与阴影 */
        background-color: rgba(154, 138, 255, 0.12);

        /* 6. 文字 */
        color: #e8e2ff;
    }

    .toc-section-link.active
    {
        /* 4. 边框圆角 */
        border-left-color: #ffd866;

        /* 5. 背景与阴影 */
        background-color: rgba(255, 216, 102, 0.1);

        /* 6. 文字 */
        color: #ffd866;
    }

    .toc-group
    {
        /* 1. 布局定位 */
        position: relative;

        /* 3. 盒模型 - 间距 */
        margin-bottom: 1rem;
        padding: 0.6rem 0.6rem 0.4rem;

        /* 4. 边框圆角 */
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, 0.06);

        /* 5. 背景与阴影 */
        background-color: rgba(255, 255, 255, 0.02);

        /* 10. 动画过渡 */
        transition: background-color 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }

    .toc-group.active
    {
        /* 4. 边框圆角 */
        border-color: rgba(154, 138, 255, 0.35);

        /* 5. 背景与阴影 */
        background-color: rgba(154, 138, 255, 0.08);
        box-shadow: inset 0 0 12px rgba(154, 138, 255, 0.15),
            0 0 16px rgba(154, 138, 255, 0.2);
    }

    .toc-group-title
    {
        /* 默认不 sticky */

        /* 1. 布局定位 */
        position: static;

        /* 3. 盒模型 - 间距 */
        padding: 0.3rem 0;
        margin-bottom: 0.4rem;

        /* 4. 边框圆角 */
        border-bottom: 1px dashed rgba(154, 138, 255, 0.25);

        /* 6. 文字 */
        color: #ffd866;
        font-size: 0.9rem;
        font-weight: 600;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .toc-group.with-title .toc-group-title
    {
        /* 1. 布局定位 */
        position: sticky;
        top: var(--toc-hero-height, 60vh);
        z-index: 2;

        /* 5. 背景与阴影 */
        background-color: rgba(31, 30, 51, 0.96);

        /* 10. 动画过渡 */
        transition: top 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .toc-list
    {
        /* 3. 盒模型 - 间距 */
        margin: 0;
        padding: 0;

        /* 6. 文字 */
        list-style: none;
    }

    .toc-item
    {
        /* 3. 盒模型 - 间距 */
        margin: 0.15rem 0;
    }

    .toc-link
    {
        /* 2. 盒模型 - 尺寸与排列 */
        display: block;

        /* 3. 盒模型 - 间距 */
        padding: 0.15rem 0;

        /* 4. 边框圆角 */
        border-radius: 4px;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.6);
        text-decoration: none;
        font-size: 0.85rem;
        line-height: 1.5;
        word-break: break-word;
        overflow-wrap: break-word;
        white-space: normal;

        /* 10. 动画过渡 */
        transition: color 0.25s ease, background-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
    }

    .toc-link:hover
    {
        /* 5. 背景与阴影 */
        background-color: rgba(154, 138, 255, 0.12);
        box-shadow: inset 0 0 12px rgba(154, 138, 255, 0.3),
            0 0 12px rgba(154, 138, 255, 0.45),
            0 0 24px rgba(154, 138, 255, 0.2);

        /* 6. 文字 */
        color: #9a8aff;
        text-decoration: underline;
        text-underline-offset: 0.1875rem;
        text-decoration-color: rgba(154, 138, 255, 0.6);
        text-decoration-thickness: 1px;

        /* 10. 动画过渡 */
        transform: translateX(0.25rem);
    }

    .toc-link.active:not(:hover)
    {
        /* 5. 背景与阴影 */
        background-color: rgba(255, 216, 102, 0.12);
        box-shadow: inset 0 0 12px rgba(255, 216, 102, 0.2),
            0 0 12px rgba(255, 216, 102, 0.3);

        /* 6. 文字 */
        color: #ffd866;
    }
</style>


<script>
    import { Common as C } from "@/utils/Common/Common"; 

    (() =>
    {
        const links: HTMLAnchorElement[] = Array.from(
            document.querySelectorAll<HTMLAnchorElement>(".toc-link, .toc-section-link")
        );
        const headings: { el: HTMLElement; slug: string }[] = [];

        for (const link of links)
        {
            const slug = link.dataset.slug;
            if (!slug) continue;

            const el = document.getElementById(slug);
            if (el) headings.push({ el, slug });
        }

        if (headings.length === 0) return;

        const groups: HTMLElement[] = Array.from(
            document.querySelectorAll<HTMLElement>(".toc-group")
        );

        // let OFFSET: number = window.innerHeight * 0.25;
        // window.addEventListener("resize", () =>
        // {
        //     OFFSET = window.innerHeight * 0.25;
        // });

        function findScrollContainer(el: HTMLElement): HTMLElement | null
        {
            let parent: HTMLElement | null = el.parentElement;
            while (parent)
            {
                const overflowY = getComputedStyle(parent).overflowY;
                if (overflowY === "auto" || overflowY === "scroll")
                {
                    return parent;
                }
                parent = parent.parentElement;
            }
            return null;
        }

        let lastActiveSlug: string | null = null;

        function updateActive(): void
        {
            const offset = Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
            let activeSlug: string | null = null;

            for (const { el, slug } of headings)
            {
                const top = el.getBoundingClientRect().top;
                if (top <= offset + C.WOR_EPSILON_PX)
                {
                    activeSlug = slug;
                }
                else
                {
                    break;
                }
            }

            if (!activeSlug && headings.length > 0)
            {
                activeSlug = headings[0].slug;
            }

            // 计算需要高亮的所有 slug（自身 + 祖先）
            const activeSlugs = new Set<string>();
            if (activeSlug) activeSlugs.add(activeSlug);

            const activeLink = links.find(l => l.dataset.slug === activeSlug);
            if (activeLink)
            {
                const activeIndex = links.indexOf(activeLink);
                const activeDepth = Number(activeLink.dataset.depth ?? "0");

                // 往前找 depth 依次递减的祖先，直到 depth 3
                let targetDepth = activeDepth - 1;
                for (let i = activeIndex - 1; i >= 0 && targetDepth >= 3; i--)
                {
                    const link = links[i];
                    const depth = Number(link.dataset.depth ?? "0");
                    if (depth === targetDepth)
                    {
                        const slug = link.dataset.slug;
                        if (slug) activeSlugs.add(slug);
                        targetDepth--;
                    }
                }
            }

            // 应用 active
            for (const link of links)
            {
                link.classList.toggle("active", activeSlugs.has(link.dataset.slug ?? ""));
            }

            // 更新分组高亮
            for (const groupEl of groups)
            {
                const groupLinks = groupEl.querySelectorAll(".toc-link");
                let isActive = false;
                groupLinks.forEach((link) =>
                {
                    if (link instanceof HTMLElement && link.dataset.slug === activeSlug)
                    {
                        isActive = true;
                    }
                });
                groupEl.classList.toggle("active", isActive);
            }

            if (activeSlug !== lastActiveSlug)
            {
                lastActiveSlug = activeSlug;

                // const activeLink = links.find(l => l.dataset.slug === activeSlug);
                if (!activeLink) return;

                const container = findScrollContainer(activeLink);
                if (!container) return;

                const containerRect = container.getBoundingClientRect();
                const linkRect = activeLink.getBoundingClientRect();

                const targetScrollTop =
                    container.scrollTop +
                    (linkRect.top - containerRect.top) -
                    (containerRect.height / 2) +
                    (linkRect.height / 2);

                container.scrollTo({
                    top: targetScrollTop,
                    behavior: "smooth",
                });
            }
        }

        window.addEventListener("scroll", updateActive, { passive: true });
        updateActive();
    })();
</script>

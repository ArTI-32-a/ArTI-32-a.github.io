---
// 这是一个纯展示组件，不需要额外 JS 依赖
---

<div id="splash-overlay">
    <div id="click-blocker">
    </div>

    <div id="splash-content">
        <span id="typewriter-text"></span>
        <span id="cursor-blink"></span>
    </div>
</div>

<script>
    const TARGET_TEXT: string = "ΛrTI_";
    
    const TYPING_INTERVAL: number = 150;
    const PAUSE_TIME: number = 1000;

    let state: number = 0;
    let timerHandle: number | null = null;

    let textDisplayElement: HTMLElement | null = null;
    let overlayContainerElement: HTMLElement | null = null;


    function transition(): string
    {
        switch (state)
        {
            case 0:
            case 1:
            case 2:
            case 3:
            case 4:
            
            case -5:
            case -4:
            case -3:
            case -2:
                state += 1;
                return TARGET_TEXT.substring(0, Math.abs(state));
            case 5:
                state = -5;
                return TARGET_TEXT;
            case -1:
                state = 0;
                return "";

            default:
                throw new Error("state is wrong");
        }
    }

    function tick(): void
    {
        if (!textDisplayElement || !overlayContainerElement) 
        {
            return;
        }


        // 5状态
        if (state === 5)
        {
            if (timerHandle !== null)
            {
                window.clearInterval(timerHandle);
                timerHandle = null;
            }

            setTimeout((): void => 
            {
                const display: string = transition();

                if (!textDisplayElement)
                {
                    return;
                }
                textDisplayElement.textContent = display;

                // 下一阶段
                if (timerHandle === null)
                {
                    timerHandle = window.setInterval(tick, TYPING_INTERVAL);
                }
            }, PAUSE_TIME);

            return;
        }


        // 常态
        const display: string = transition();

        textDisplayElement.textContent = display;


        if (state === 0)
        {
            if (timerHandle !== null)
            {
                window.clearInterval(timerHandle);
                timerHandle = null;
            }

            overlayContainerElement.classList.add("splash-hidden");

            const completeEvent: CustomEvent = new CustomEvent("splash-complete");
            document.dispatchEvent(completeEvent);

            setTimeout((): void =>
            {
                const blocker = document.getElementById("click-blocker");
                if (blocker)
                {
                    blocker.remove();
                    // console.log("removed");
                }
            }, 1200);
        }
    }


    function startAnimation(): void
    {
        state = 0;

        overlayContainerElement = document.getElementById("splash-overlay");
        textDisplayElement = document.getElementById("typewriter-text");

        if (!overlayContainerElement || !textDisplayElement) 
        {
            console.warn("Splash intro DOM elements not found.");
            return;
        }

        textDisplayElement.textContent = "";
        overlayContainerElement.classList.remove("splash-hidden");
        
        if (timerHandle !== null)
        {
            clearInterval(timerHandle);
            timerHandle = null;
        }


        if (timerHandle === null)
        {
            timerHandle = window.setInterval(tick, TYPING_INTERVAL);
        }
    }

    function init(): void 
    {
        if (document.readyState === "complete" || document.readyState === "interactive") 
        {
            startAnimation();
        } 
        else 
        {
            document.addEventListener("DOMContentLoaded", startAnimation);
        }
    }

    init();
</script>


<style>
    /*
        ---------- 1. 开场遮罩层 ----------
    */
    #splash-overlay
    {
        /* 1. 布局定位 */
        position: fixed;
        inset: 0;
        z-index: 9999;

        /* 2. 盒模型 - 尺寸 */
        display: flex;
        align-items: center;
        justify-content: center;

        /* 5. 背景 */
        background-color: #1f1e33;

        /* 7. 视觉效果 */
        opacity: 1;
        visibility: visible;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transition: opacity 0.8s ease, visibility 0.8s ease;
    }

    /*
        ---------- 遮罩隐藏状态（由 JS 添加） ----------
    */
    #splash-overlay.splash-hidden
    {
        /* 7. 视觉效果 */
        opacity: 0;
        visibility: hidden;

        /* 9. 交互 */
        pointer-events: none;
    }

    /*
        ---------- 2. 文字容器（整体居中） ----------
    */
    #splash-content
    {
        /* 2. 盒模型 - 尺寸 */
        display: flex;
        align-items: center;
        justify-content: center;

        /* 3. 盒模型 - 间距 */
        margin: 0;
        padding: 0;

        /* 6. 文字 */
        color: #ffffff;
        font-size: clamp(2rem, 8vw, 4rem);
        font-family: "Courier New", "Fira Code", monospace;
        letter-spacing: 0.08em;
        line-height: 1;
        white-space: nowrap;
    }

    /*
        ---------- 3. 动态文字区域（继承父容器） ----------
    */
    #typewriter-text
    {
        /* 无需额外样式，完全继承 */
    }

    /*
        ---------- 4. 闪烁光标 ----------
    */
    #cursor-blink
    {
        /* 2. 盒模型 - 尺寸 */
        display: inline-block;
        width: 0.08em;
        height: 1.1em;

        /* 5. 背景 */
        background-color: #ffffff;

        /* 3. 盒模型 - 间距 */
        margin-left: 0.05em;

        /* 10. 动画过渡 */
        animation: blink 0.7s step-end infinite;
    }

    /*
        ---------- 5. 光标闪烁关键帧 ----------
    */
    @keyframes blink
    {
        0%,
        100%
        {
            opacity: 1;
        }
        50%
        {
            opacity: 0;
        }
    }

    /*
        ---------- 透明的点击拦截层 ----------
    */
    #click-blocker
    {
        /* 1. 布局定位 */
        position: absolute;
        inset: 0;
        z-index: 99999;  /* 一定要高于所有内容 */

        /* 2. 盒模型 - 尺寸 */
        display: block;

        /* 5. 背景（完全透明，肉眼看不见） */
        background-color: transparent;

        /* 9. 交互（关键！这个层负责拦截所有点击） */
        pointer-events: auto;  /* 默认就是 auto，显式写上更清楚 */
        cursor: default;
    }
</style>
<div id="three-container">
</div>



<script>
    import * as THREE from "three";

    const container: HTMLElement | null = document.getElementById("three-container");
    if (!container)
    {
        throw new Error("Three.js container not found.");
    }

    const scene: THREE.Scene = new THREE.Scene();

    // 创建相机（透视相机：视野60度，宽高比自动适配，近裁面0.1，远裁面1000）
    const camera: THREE.PerspectiveCamera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.set(3, 2, 5);
    camera.lookAt(0, 0, 0);

    // 创建渲染器
    const renderer: THREE.WebGLRenderer = new THREE.WebGLRenderer(
    {
        antialias: true,
        alpha: true,
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // 限制最高2倍像素比，平衡性能
    container.appendChild(renderer.domElement);

    // 添加几何体
    const geometry: THREE.IcosahedronGeometry = new THREE.IcosahedronGeometry(2, 0);
    const material: THREE.MeshStandardMaterial = new THREE.MeshStandardMaterial(
    {
        color: 0x7a6bff,
        roughness: 0.3,
        metalness: 0.6,
        emissive: 0x2a1f4a,
        emissiveIntensity: 0.2,
        wireframe: false,
    });
    const torusKnot: THREE.Mesh = new THREE.Mesh(geometry, material);
    scene.add(torusKnot);

    // ----- 6. 添加边缘线框（增加科技感） -----
    const edges: THREE.EdgesGeometry = new THREE.EdgesGeometry(geometry);
    const lineMaterial: THREE.LineBasicMaterial = new THREE.LineBasicMaterial({
        color: 0x9a8aff,
        transparent: true,
        opacity: 0.3,
    });
    const wireframe: THREE.LineSegments = new THREE.LineSegments(edges, lineMaterial);
    torusKnot.add(wireframe); // 将线框作为子元素添加到 torusKnot，会跟随一起旋转

    // ----- 7. 添加环境光和平行光，让物体有立体感 -----
    const ambientLight: THREE.AmbientLight = new THREE.AmbientLight(0x404060);
    scene.add(ambientLight);

    const directionalLight: THREE.DirectionalLight = new THREE.DirectionalLight(0xffffff, 1);
    directionalLight.position.set(5, 5, 5);
    scene.add(directionalLight);

    const backLight: THREE.DirectionalLight = new THREE.DirectionalLight(0x6a5acd, 0.5);
    backLight.position.set(-3, -1, -3);
    scene.add(backLight);

    // ----- 8. 动画循环 -----
    const DELTA_SCALE = 0.0005;

    let isShrinking: boolean = true;
    let currScale: number = 1;
    
    function animate(): void
    {
        requestAnimationFrame(animate);

        // 让环面结缓慢旋转
        torusKnot.rotation.x += 0.005;
        torusKnot.rotation.y += 0.01;

        currScale += isShrinking ? -DELTA_SCALE : DELTA_SCALE;
        torusKnot.scale.set(currScale, currScale, currScale);

        if (currScale > 1)
        {
            isShrinking = true;
        }
        else if (currScale < 0.8)
        {
            isShrinking = false;
        }

        renderer.render(scene, camera);
    }
    animate();

    // ----- 9. 处理窗口大小变化 -----
    function resizeRenderer(): void
    {
        if (container)
        {
            const width: number = container.clientWidth;
            const height: number = container.clientHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        }
    }
    window.addEventListener("resize", resizeRenderer);
</script>



<style>
    #three-container
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 10;

        /* 2. 盒模型 - 尺寸 */
        width: 160px;
        height: 160px;

        /* 9. 交互 */
        pointer-events: none; /* 让鼠标穿透，不阻挡卡片点击 */

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    #three-container canvas
    {
        /* 确保 canvas 填满容器，且不溢出 */
        display: block;
        width: 100%;
        height: 100%;
    }
</style>
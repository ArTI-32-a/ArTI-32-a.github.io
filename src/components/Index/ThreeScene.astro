<div id="three-container">
    <div class="three-tooltip">
        信息面板
    </div>
</div>



<script>
    import { EventName as EN } from "@/utils/Common/Event";
    import { Common as C} from "@/utils/Common/Common";
    import * as THREE from "three";

    const containerEl: HTMLElement | null = document.getElementById("three-container");
    if (!containerEl)
    {
        throw new Error("Three.js container not found.");
    }
    const container: HTMLElement = containerEl;

    const scene: THREE.Scene = new THREE.Scene();

    // 创建相机（透视相机：视野60度，宽高比自动适配，近裁面0.1，远裁面1000）
    const camera: THREE.PerspectiveCamera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
    camera.position.set(3, 2, 5);
    camera.lookAt(0, 0, 0);

    // 创建渲染器
    const renderer: THREE.WebGLRenderer = new THREE.WebGLRenderer(
    {
        antialias: true,
        alpha: true,
    });
    renderer.setSize(container.clientWidth, container.clientHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2)); // 限制最高2倍像素比，平衡性能
    container.appendChild(renderer.domElement);

    // 添加几何体
    const geometry: THREE.IcosahedronGeometry = new THREE.IcosahedronGeometry(2, 0);
    const material: THREE.MeshStandardMaterial = new THREE.MeshStandardMaterial(
    {
        color: 0x7a6bff,
        roughness: 0.3,
        metalness: 0.6,
        emissive: 0x2a1f4a,
        emissiveIntensity: 0.2,
        wireframe: false,
    });
    const torusKnot: THREE.Mesh = new THREE.Mesh(geometry, material);
    scene.add(torusKnot);

    // ----- 6. 添加边缘线框（增加科技感） -----
    const edges: THREE.EdgesGeometry = new THREE.EdgesGeometry(geometry);
    const lineMaterial: THREE.LineBasicMaterial = new THREE.LineBasicMaterial({
        color: 0x9a8aff,
        transparent: true,
        opacity: 0.3,
    });
    const wireframe: THREE.LineSegments = new THREE.LineSegments(edges, lineMaterial);
    torusKnot.add(wireframe); // 将线框作为子元素添加到 torusKnot，会跟随一起旋转

    // ----- 7. 添加环境光和平行光，让物体有立体感 -----
    const ambientLight: THREE.AmbientLight = new THREE.AmbientLight(0x404060);
    scene.add(ambientLight);

    const directionalLight: THREE.DirectionalLight = new THREE.DirectionalLight(0xffffff, 1);
    directionalLight.position.set(5, 5, 5);
    scene.add(directionalLight);

    const backLight: THREE.DirectionalLight = new THREE.DirectionalLight(0x6a5acd, 0.5);
    backLight.position.set(-3, -1, -3);
    scene.add(backLight);

    // ----- 8. 动画循环 -----
    type Phase = "breathing" | "expanding" | "shrinking";

    const DELTA_SCALE = C.IND_3D_BREATH_DELTA;

    let phase: Phase = "breathing";
    let currScale: number = 1;
    let isShrinkingBreath: boolean = true;
    let phaseStartTime: number = 0;
    let phaseStartScale: number = 1;

    let lastTimestamp: number | null = null;
    
    function animate(timestamp: number): void
    {
        requestAnimationFrame(animate);

        const frameFactor = lastTimestamp === null
            ? 1
            : Math.min((timestamp - lastTimestamp) / (1000 / 60), 3);

        // 让环面结缓慢旋转
        torusKnot.rotation.x += 0.01 * frameFactor;
        torusKnot.rotation.y += 0.02 * frameFactor;

        lastTimestamp = timestamp;

        if (phase === "breathing")
        {   
            currScale += (isShrinkingBreath ? -DELTA_SCALE : DELTA_SCALE) * frameFactor;

            if (currScale > C.IND_3D_BREATH_MAX)
            {
                isShrinkingBreath = true;
            }
            else if (currScale < C.IND_3D_BREATH_MIN)
            {
                isShrinkingBreath = false;
            }
        }
        else if (phase === "expanding")
        {
            const elapsed = timestamp - phaseStartTime;
            const t = Math.min(elapsed / C.IND_3D_CLICK_DURATION_MS, 1);
            currScale = phaseStartScale + (C.IND_3D_CLICK_EXP_SCALE - phaseStartScale) * t;

            if (t >= 1)
            {
                phase = "shrinking";
                phaseStartTime = timestamp;
                phaseStartScale = currScale;

                // 缩回刚开始 → 通知菜单打开
                document.dispatchEvent(new CustomEvent(EN.INF_MENU_OPEN_EVENT));
            }
        }
        else if (phase === "shrinking")
        {
            const elapsed = timestamp - phaseStartTime;
            const t = Math.min(elapsed / C.IND_3D_CLICK_DURATION_MS, 1);
            currScale = phaseStartScale + (C.IND_3D_CLICK_SHR_SCALE - phaseStartScale) * t;

            if (t >= 1)
            {
                phase = "breathing";
                // currScale = C.IND_3D_BREATH_MAX;
                isShrinkingBreath = true;
            }
        }

        
        torusKnot.scale.set(currScale, currScale, currScale);

        renderer.render(scene, camera);
    }
    requestAnimationFrame(animate);

    // ----- 9. 处理窗口大小变化 -----
    function resizeRenderer(): void
    {
        if (container)
        {
            const width: number = container.clientWidth;
            const height: number = container.clientHeight;
            camera.aspect = width / height;
            camera.updateProjectionMatrix();
            renderer.setSize(width, height);
        }
    }


    window.addEventListener("resize", resizeRenderer);

    container.addEventListener("click", () =>
    {
        if (phase !== "breathing") return;

        phase = "expanding";
        phaseStartTime = performance.now();
        phaseStartScale = currScale;
    });
</script>



<style>
    #three-container
    {
        /* 1. 布局定位 */
        position: absolute;
        top: 50%;
        left: 50%;
        z-index: 10;

        /* 2. 盒模型 - 尺寸 */
        width: 20vmin;
        height: 20vmin;

        /* 9. 交互 */
        pointer-events: auto; /* 让鼠标穿透，不阻挡卡片点击 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transform: translate(-50%, -50%);
    }

    #three-container canvas
    {
        /* 确保 canvas 填满容器，且不溢出 */
        display: block;
        width: 100%;
        height: 100%;
    }



    .three-tooltip
    {
        /* 1. 布局定位 */
        position: absolute;
        top: -2.5rem;
        left: 50%;
        z-index: 1;

        /* 2. 盒模型 - 尺寸 */
        display: block;
        white-space: nowrap;

        /* 3. 盒模型 - 间距 */
        padding: 0.4rem 0.8rem;

        /* 4. 边框圆角 */
        border-radius: 0.5rem;

        /* 5. 背景 */
        background-color: rgba(20, 20, 40, 0.9);
        backdrop-filter: blur(6px);
        border: 1px solid rgba(154, 138, 255, 0.4);
        box-shadow: 0 0.3rem 1rem rgba(0, 0, 0, 0.4);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 0.9rem;
        font-family: "Segoe UI", "PingFang SC", sans-serif;

        /* 7. 视觉效果 */
        opacity: 0;
        visibility: hidden;

        /* 9. 交互 */
        pointer-events: none;

        /* 10. 动画过渡 */
        transform: translateX(-50%) translateY(0.5rem);
        transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    }

    #three-container:hover .three-tooltip
    {
        /* 7. 视觉效果 */
        opacity: 1;
        visibility: visible;

        /* 10. 动画过渡 */
        transform: translateX(-50%) translateY(0);
    }

    .contact-menu[data-state="open"] ~ #three-container .three-tooltip
    {
        
    }
</style>

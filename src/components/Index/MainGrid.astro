---
import TS from "@/components/Index/ThreeScene.astro";
---


<div class="main-grid">
    <TS />

    <a class="grid-item item-tl" href="/notes/acat">
        <span class="item-title">
            Notes
        </span>
        <span class="item-sub">
            这里空空如也喵~
        </span>
    </a>

    <a class="grid-item item-tr" href="/wps/acat">
        <span class="item-title">
            Write Up
        </span>
        <span class="item-sub">
            目前存放了CTF && 电子取证的部分笔记喵~
        </span>
    </a>

    <a class="grid-item item-bl" href="/games/acat">
        <span class="item-title">
            Games(?)
        </span>
        <span class="item-sub">
            本来是准备放游戏研究的说~
        </span>
        <span class="item-sub">
            这里空空如也喵~
        </span>
    </a>

    <a class="grid-item item-br" href="/worlds/acat">
        <span class="item-title">
            World
        </span>
        <span class="item-sub">
            放世界观的()
        </span>
        <span class="item-sub">
            这里空空如也喵~
        </span>
    </a>
</div>



<style>
    /*
        ---------- 1. 2×2 网格容器 ----------
    */
    .main-grid
    {
        /* 1. 布局定位 */
        position: relative;

        /* 2. 盒模型 - 尺寸 */
        display: grid;
        grid-template-columns: 1fr 1fr;  /* 两列等宽 */
        grid-template-rows: 1fr 1fr;     /* 两行等高 */
        gap: 10px;                       /* 这就是我们说的“真空裂隙” */
        width: 100vw;
        height: 100vh;

        /* 5. 背景（透过 gap 露出来的底色） */
        background-color: #1f1e33;

        /* 9. 交互（防止内部文字被意外选中） */
        user-select: none;
    }

    /*
        ---------- 2. 单个卡片区域 ----------
    */
    .grid-item
    {
        /* 2. 盒模型 - 尺寸 */
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;

        /* 3. 盒模型 - 间距 */
        padding: 2rem;

        /* 5. 背景（中心亮、边缘暗，制造深邃感） */
        background: radial-gradient(circle at 50% 50%, #2a2744 0%, #1f1e33 100%);

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.85);
        text-decoration: none;      /* 去掉 <a> 默认的下划线 */
        text-align: center;

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡（悬停时的平滑变化） */
        transition: background 0.4s ease, transform 0.3s ease;
    }
    /* 左上角块：右下角变圆（让出中心） */
    .item-tl
    {
        border-radius: 0 0 150px 0;  /* 顺序：左上 右上 右下 左下 */
    }

    /* 右上角块：左下角变圆 */
    .item-tr
    {
        border-radius: 0 0 0 150px;
    }

    /* 左下角块：右上角变圆 */
    .item-bl
    {
        border-radius: 0 150px 0 0;
    }

    /* 右下角块：左上角变圆 */
    .item-br
    {
        border-radius: 150px 0 0 0;
    }

    /*
        ---------- 3. 卡片悬停效果 ----------
    */
    .grid-item:hover
    {
        /* 5. 背景（悬停时整体提亮） */
        background: radial-gradient(circle at 50% 50%, #3b375a 0%, #1f1e33 100%);

        /* 10. 动画过渡（轻微放大，增加呼吸感） */
        transform: scale(1.02);
    }

    /*
        ---------- 4. 卡片标题（主文字） ----------
    */
    .item-title
    {
        /* 6. 文字 */
        font-size: 2rem;
        font-weight: 300;           /* 细体，更符合哲学感 */
        letter-spacing: 0.15em;     /* 字间距拉大，显得庄重 */
        font-family: "Courier New", "Fira Code", monospace;
    }

    /*
        ---------- 5. 卡片副标题（诠释文字） ----------
    */
    .item-sub
    {
        /* 6. 文字 */
        font-size: 0.9rem;
        font-weight: 300;
        opacity: 0.6;               /* 半透明，退居幕后 */
        margin-top: 0.5rem;
        letter-spacing: 0.05em;
        font-family: "Segoe UI", "PingFang SC", sans-serif;
    }
</style>
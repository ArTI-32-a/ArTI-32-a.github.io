---
import toEntry from "@/assets/pictures/button/to_ctf_entry.svg";

const { href = "/", text = "...", showElli = false, level = 0, id = "0" } = Astro.props;
---

<a id={id} class:list={["btn", showElli ? "ellipsis" : undefined]} href={href}>
    <span class="btn-text">
        {text}
    </span>
</a>

<script define:vars={{ level, showElli, id }}>
    if (showElli)
    {
        const container = document.getElementById(id);
        if (!container)
        {
            console.error("container is null");
            return;
        }

        let lv = level;
        lv = (lv < 0) ? 0 : lv;
        container.style.width = `${230 - ((lv) * 30 + 10)}px`;
    }
</script>



<style>
    .btn
    {
        display: block;

        text-decoration: none;
    }
    .btn:link, .btn:hover, .btn:visited, .btn:active
    {
        color: aquamarine;
    }

    .ellipsis
    {
        width: 230px;

        overflow-x: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }
</style>
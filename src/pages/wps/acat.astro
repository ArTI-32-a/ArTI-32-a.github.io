---
import Layout from "@/layouts/WPs/Catalog.astro";

import Cs from "@/components/WPs/Shared/Catalog/Switcher.astro";
import Hero from "@/components/WPs/Shared/Catalog/Hero.astro";

import IT from "@/components/WPs/Shared/Catalog/IndexTable.astro";

import { buildTree } from "@/utils/WPs/Catalog";


const ctfTree = await buildTree("CTF");
const dfTree = await buildTree("DF");


const ctfTitle: string = "CTF 题解";
const dfTitle: string = "电子取证";
const titles: string[] = [ctfTitle, dfTitle];
---

<Layout>
    <Hero slot="header" titles={titles} />


    <Cs slot="article"
        entries=
        {[
            { title: ctfTitle, tree: ctfTree, collectionName: "CTF" },
            { title: dfTitle, tree: dfTree, collectionName: "DF" },
        ]}
        defaultIndex={0} 
    />

    <IT slot="article" titles={titles}>
    </IT>
</Layout>
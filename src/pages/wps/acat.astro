---
import Layout from "@/layouts/WPs/Catalog.astro";

import Cs from "@/components/WPs/CatalogSwitcher.astro"
import { buildTree } from "@/utils/WPs/Catalog";


const ctfTree = await buildTree("CTF");
const dfTree = await buildTree("DF");
---

<Layout>
    <Cs 
        entries=
        {[
            { title: "CTF", tree: ctfTree },
            { title: "Digital Forensic", tree: dfTree },
        ]}
        defaultIndex={0} 
    />
</Layout>
---
import { getCollection, render } from "astro:content";
import { getEntry } from "astro:content";

import Layout from "@/layouts/WPs/CTFSlug.astro";

import bUp from "@/assets/pictures/background/wp/wp_up_bg.png?url";

import Hero from "@/components/WPs/Hero.astro";

import { buildTree } from "@/utils/WPs/Catalog";

export async function getStaticPaths()
{
    const posts = await getCollection("CTF");
    return posts.map((post) =>
    {
        return {
            params: { slug: post.id },
        };
    });
}

const { slug } = Astro.params;

if (!slug)
{
    return Astro.redirect("/404");
}

const entry = await getEntry("CTF", slug);

if (!entry)
{
    return Astro.redirect("/404");
}

const { Content, headings } = await render(entry);


const tree = await buildTree("CTF");
---

<Layout title={entry.data.title} headings={headings}>
    <div slot="header">
        <Hero data={entry.data} headings={headings} backgroundImage={bUp} treeInfo={tree}/>
    </div>
    

    <article>
        <Content />
    </article>
</Layout>
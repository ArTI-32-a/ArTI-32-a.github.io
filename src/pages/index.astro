---
import Layout from "@/layouts/Index.astro";

import SI from "@/components/Index/SplashIntro.astro";
import MG from "@/components/Index/MainGrid.astro";
---

<Layout>

    <SI />

    <div id="main-app">
        <MG />
    </div>

    
</Layout>



<script>
    document.addEventListener("splash-complete", (): void => 
    {
        const mainGrid = document.getElementById("main-app");
        if (!mainGrid)
        {
            throw new Error("mainGrid is missing");
        }

        mainGrid.style.display = "block";

        mainGrid.style.opacity = "0";

        requestAnimationFrame((): void => 
        {
            mainGrid.style.transition = "opacity 0.8s ease";
            mainGrid.style.opacity = "1";
        });
    });



    import { indexListener } from "@/utils/Index/Listener";

    indexListener();
</script>



<style>
    #main-app
    {
        /* 1. 布局定位 */
        position: relative;

        /* 7. 视觉效果 */
        opacity: 0;             /* 初始透明，JS 会改为 1 */

        /* 10. 动画过渡 */
        transition: opacity 0.8s ease;
    }
</style>
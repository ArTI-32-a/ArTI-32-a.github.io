---
import Layout from "@/layouts/Index.astro";

import SI from "@/components/Index/SplashIntro.astro";
import MG from "@/components/Index/MainGrid.astro";

import IBM from "@/components/Shared/InfoBoard/Menu.astro";
---



<Layout>

    <SI />

    <div id="main-app">
        <MG />
    </div>

    <IBM>

    </IBM>
</Layout>



<script>
    (() =>
    {
        const mainGridEl = document.getElementById("main-app");

        if (!(mainGridEl instanceof HTMLElement))
        {
            return;
        }

        const mainGrid = mainGridEl;
        let shown: boolean = false;

        function showMainApp(): void
        {
            if (shown)
            {
                return;
            }

            shown = true;
            mainGrid.style.display = "block";

            requestAnimationFrame(() =>
            {
                mainGrid.style.opacity = "1";
            });
        }

        document.addEventListener("splash-complete", showMainApp);

        // 事件可能早于监听发出，此时直接读取完成状态。
        if (document.documentElement.dataset.splashComplete === "true")
        {
            showMainApp();
        }
    })();



    import { indexListener } from "@/utils/Index/Listener";

    indexListener();
</script>



<style>
    #main-app
    {
        /* 初始透明，JS 会改为 1 */

        /* 1. 布局定位 */
        position: relative;

        /* 7. 视觉效果 */
        opacity: 0;

        /* 10. 动画过渡 */
        transition: opacity 0.8s ease;
    }
</style>

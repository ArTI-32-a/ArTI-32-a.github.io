---

import Layout from "@/layouts/Index.astro";
import ToContent from "@/components/Buttons/ToContent.astro";
---

<Layout title="Front">

    <ToContent id="notes" href="/notes/acat" text="notes" x="50vw" y="50vh"/>
    <ToContent id="settings" href="/settings/acat" text="settings" x="50vw" y="50vh"/>
    <ToContent id="wps" href="/wps/acat" text="wps" x="50vw" y="50vh"/>

    <!-- <div style="background-color: white; width: 40vw; height: 50vh; left: 60vw; position: absolute;" /> -->

</Layout>

<script>
    import { indexListener } from "@/utils/controller/index-listener";
    import { ToolBox as TB } from "@/utils/Common/ToolBox.ts";

    indexListener();


    const notes = document.getElementById("notes");
    const settings = document.getElementById("settings");
    const wps = document.getElementById("wps");

    if (!notes || !settings || !wps)
    {
        throw new Error("three button can't be found by id");
    }

    const buttons = [ notes, settings, wps ];

    // const noteHeight = buttons[0].getBoundingClientRect().height;
    // const noteWidth = buttons[0].getBoundingClientRect().width;
    // const settingHeight = buttons[1].getBoundingClientRect().height;
    // const settingWidth = buttons[1].getBoundingClientRect().width;
    // const wpHeight = buttons[2].getBoundingClientRect().height;
    // const wpWidth = buttons[2].getBoundingClientRect().width;

    // if (TB.isZero(noteHeight) || 
    //     TB.isZero(noteWidth) || 
    //     TB.isZero(settingHeight) || 
    //     TB.isZero(settingWidth) || 
    //     TB.isZero(wpHeight) || 
    //     TB.isZero(wpWidth))
    // {
    //     throw new Error("at least one of the height or width of buttons is zero");
    // }


    const zones = 
    [
        { left: 0, top: 0, width: 40, height: 100},
        { left: 60, top: 0, width: 40, height: 100},

    ];
    const placed: { x: number; y: number; w: number; h: number }[] = [];

    const padding = 3;

    
    buttons.forEach((btn) =>
    {
        const h = TB.pxToVh(btn.getBoundingClientRect().height);
        const w = TB.pxToVw(btn.getBoundingClientRect().width);
        if (TB.isZero(h) || TB.isZero(w)) { throw new Error("at least one of the height or width of buttons is zero"); }
        
        let x: number = 0;
        let y: number = 0;
        let overlap: boolean = false;
        let overflow: boolean = false;

        do {
            const zone = zones[Math.floor(Math.random() * zones.length)];
            x = zone.left + Math.random() * zone.width;
            y = zone.top + Math.random() * zone.height; 

            overflow = (y + h > zone.top + zone.height) || (x + w > zone.left + zone.width + padding);
            overlap = placed.some
            (p => 
                x < p.x + p.w && x + w > p.x &&
                y < p.y + p.h && y + h > p.y
            );
        } while (overlap || overflow)

        btn.style.left = x + "vw";
        btn.style.top = y + "vh";
        placed.push({x, y, w, h});
    }); 

</script>
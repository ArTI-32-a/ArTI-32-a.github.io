---
import "@/styles/global.css";

import TOC from "@/components/WPs/CTFs/TOC.astro";
import BtnMenu from "@/components/WPs/Shared/BtnMenu.astro";
import Btn from "@/components/WPs/Shared/Btn.astro";

const { title = "Arutiko", headings = [] } = Astro.props;
---

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>{title}</title>
    </head>

    <body>
        <div class="mask" id="mask">
            <slot name="header">
            </slot>
        </div>

        <div class="main-area" id="main-area">
            <article class="article-area">
                <slot />
            </article>
        </div>

        <aside class="toc-area" id="toc-area">
            <div class="toc-top-spacer" id="toc-top-spacer" />
            <TOC headings={headings} />
            <div class="toc-bottom-spacer" />
        </aside>

        
        <BtnMenu>
            <Btn slot="up" event="toc-toggle" font={1} tip="Table of Contents">
                TOC
            </Btn>

            <Btn slot="up" event="hero-toggle" tip="展开首屏">
                H
            </Btn>

            <Btn slot="up" event="hero-auto-toggle" tip="首屏自动开、关">
                A
            </Btn>


            <Btn slot="left" event="back-to-catalog" tip="返回目录">
                {"<"}
            </Btn>

            <Btn slot="left" event="back-to-index" font={1.2} tip="返回首页">
                {"<<"}
            </Btn>
        </BtnMenu>
    </body>
</html>



<script>
    import { articleController } from "@/utils/WPs/CTFs/ArticleController";

    (() => 
    {
        const mask = document.getElementById("mask");
        const mainArea = document.getElementById("main-area");
        const titleBox = document.querySelector(".title-box");
        const heroColumn = document.querySelector(".hero-columns");
        const tocSpacer = document.getElementById("toc-top-spacer");
        const hero = document.getElementById("hero");

        
        if (!mask || !mainArea || !titleBox || !heroColumn || !tocSpacer || !hero)
        {
            console.warn("articleController cannot be found");
            return;
        }

        if (!(mask instanceof HTMLElement) ||
            !(mainArea instanceof HTMLElement) ||
            !(titleBox instanceof HTMLElement) ||
            !(heroColumn instanceof HTMLElement) ||
            !(tocSpacer instanceof HTMLElement) ||
            !(hero instanceof HTMLElement))
        {
            console.warn("[articleController] DOM not found");
            return;
        }

        
        articleController(
            [mask, titleBox, heroColumn, tocSpacer, hero],
            mainArea
        );
    })();



    document.addEventListener("back-to-catalog", () =>
    {
        window.location.href = "/wps/acat";
    });

    document.addEventListener("back-to-index", () =>
    {
        window.location.href = "/";
    });
</script>



<style>
    body
    {
        /* 3. 盒模型 - 间距 */
        margin: 0;
        padding: 0;

        /* 5. 背景 */
        background-color: #1f1e33;

        /* 6. 文字 */
        color: rgba(255, 255, 255, 0.9);
        font-family: "Segoe UI", "PingFang SC", sans-serif;
    }

    .mask
    {
        /* 1. 布局定位 */
        position: sticky;
        top: 0;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸 */
        width: 100%;
        height: 60vh;
        min-height: 10vh;
        max-height: 90vh;

        /* 5. 背景 */
        background-position: center 20%;
        background-size: cover;
        background-repeat: no-repeat;
        box-shadow:
            0 0 40px rgba(154, 138, 255, 1),
            0 0 80px rgba(154, 138, 255, 0.8);

        /* 8. 溢出滚动 */
        overflow: hidden;

        /* 10. 动画过渡 */
        transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .mask.shrink
    {
        /* 2. 盒模型 - 尺寸 */
        height: 20vh;
    }

    .main-area
    {
        /* 1. 布局定位 */
        position: relative;
    }

    .article-area
    {
        /* 2. 盒模型 - 尺寸 */
        /* max-width: 800px; */
        max-width: 60vw;

        /* 3. 盒模型 - 间距 */
        margin: 0 auto;
        padding: 2rem;

        /* 10. 动画过渡 */
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .main-area.toc-visible .article-area
    {
        /* 10. 动画过渡 */
        transform: translateX(-125px);
    }

    .toc-area
    {
        /* 1. 布局定位 */
        position: fixed;
        top: 0;
        right: 0;
        z-index: 500;

        /* 2. 盒模型 - 尺寸 */
        display: flex;
        flex-direction: column;
        width: 20vw;
        height: 100vh;

        /* 3. 盒模型 - 间距 */
        padding: 2rem 1.5rem;

        /* 5. 背景 */
        background-color: rgba(31, 30, 51, 0.96);
        backdrop-filter: blur(8px);
        border-left: 1px solid rgba(255, 255, 255, 0.08);

        /* 8. 溢出滚动 */
        overflow-y: auto;
        scrollbar-width: none;

        /* 10. 动画过渡 */
        transform: translateX(100%);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .toc-area::-webkit-scrollbar
    {
        display: none;
    }

    .toc-top-spacer
    {
        /* 2. 盒模型 - 尺寸 */
        height: 60vh;
        flex-shrink: 0;

        /* 10. 动画过渡 */
        transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .toc-top-spacer.shrink
    {
        /* 2. 盒模型 - 尺寸 */
        height: 20vh;
    }

    .toc-bottom-spacer
    {
        height: 10vh;
        flex-shrink: 0;
    }

    .main-area.toc-visible ~ .toc-area
    {
        /* 10. 动画过渡 */
        transform: translateX(0);
    }

    .toc-toggle
    {
        /* 1. 布局定位 */
        position: fixed;
        right: 1.5rem;
        bottom: 1.5rem;
        z-index: 1000;

        /* 2. 盒模型 - 尺寸 */
        width: 3rem;
        height: 3rem;

        /* 4. 边框圆角 */
        border-radius: 50%;
        border: 1px solid rgba(255, 255, 255, 0.15);

        /* 5. 背景 */
        background-color: rgba(31, 30, 51, 0.9);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.5);

        /* 6. 文字 */
        color: #ffffff;
        font-size: 1.5rem;

        /* 9. 交互 */
        cursor: pointer;

        /* 10. 动画过渡 */
        transition: background-color 0.2s, transform 0.2s;
    }

    .toc-toggle:hover
    {
        /* 5. 背景 */
        background-color: rgba(60, 55, 90, 0.9);

        /* 10. 动画过渡 */
        transform: scale(1.05);
    }

    .toc-toggle.active
    {
        /* 5. 背景 */
        background-color: rgba(154, 138, 255, 0.3);
    }

    .article-area
    {
        /* 后面想改正文样式，在这里加 */
    }
</style>
---
import type { MarkdownHeading } from "astro";

import WPSlug from "./WPSlug.astro";
import TOC from "@/components/WPs/CTFs/TOC.astro";

export interface Props
{
    title?: string;
    headings?: MarkdownHeading[];
}

const { title = "Arutiko", headings = [] } = Astro.props;
---

<WPSlug title={title}>
    <slot name="header" slot="header" />
    <TOC slot="toc" headings={headings} />
    <slot />
</WPSlug>

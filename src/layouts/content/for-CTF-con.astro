import bDown from "@/assets/pictures/background/wp/wp_down_bg.png?url";


import aEncUp from "@/assets/pictures/background/wp/article_bg_enc_up.png?url";
import aEncDown from "@/assets/pictures/background/wp/article_bg_enc_down.png?url";
import aUp from "@/assets/pictures/background/wp/article_bg_up.png?url";
import aDown from "@/assets/pictures/background/wp/article_bg_down.png?url";
import aMid from "@/assets/pictures/background/wp/article_bg_middle.png?url";
import aUpRuler from "@/assets/pictures/background/wp/article_bg_up_ruler.png?url";
import aDownRuler from "@/assets/pictures/background/wp/article_bg_down_ruler.png?url";
import aMidRuler from "@/assets/pictures/background/wp/article_bg_middle_ruler.png?url";

import QN from "@/components/Blocks/QuickNavigation.astro";
import HN from "@/components/Blocks/HeadNavigation.astro"

// import Cat from "@/components/Catelogs/WpCtf.astro";
// import TOC from "@/components/Catelogs/TOC.astro"
import TOC from "@/components/WPs/CTFs/TOC.astro";
import Hero from "@/components/WPs/Hero.astro";

const { title = "Anryo Senko", headings = [] } = Astro.props;
---

<!doctype html>
<html>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <title>
            {title}
        </title>
    </head>
    <body>
        <!-- <header class="mask" style={`background-image: url(${bUp})`}>
            <HN />

            <div class="titleBox" style={`background-image: url(${bTitle}); text-align: center;`}>
                <h3>
                    <slot name="header">
                    Empty!!!
                    </slot>
                </h3>
            </div>

            <div class="article-enclave-up" style={`background-image: url(${aEncUp})`} />
        </header> -->
        <div class="mask">
            <slot name="header">

            </slot>
        </div>
        <!-- <div class="mask" style={`background-image: url(${bUp});`}>
        </div> -->


        <article id="ctfArt">
            <img id="aur" class="article-measurement" src={aUpRuler} />
            <img id="adr" class="article-measurement" src={aDownRuler} />
            <img id="amr" class="article-measurement" src={aMidRuler} />

            <div class="transparent"/>

            <div id="ctfArtBg" class="article-background">
                <div id="au" class="article-background-up" style={`background-image: url(${aUp});`}/>
                <div id="am" class="article-background-middle" style={`background-image: url(${aMid});`}/>
                <div id="ad" class="article-background-down" style={`background-image: url(${aDown});`}/>
            </div>

            <div class="wrapper">
                <QN>
                    <div slot="QNI">
                        <TOC headings={headings}>
                    </div>

                    <div slot="QNII">
                        <!-- <Cat showElli={true}/> -->
                    </div>
                </QN>

                <div class="article-content">
                    <slot />
                </div>
            </div>
        </article>

        <footer style={`background-image: url(${bDown})`}>
            <div class="article-enclave-down" style={`background-image: url(${aEncDown})`} />
        </footer>
    </body>
</html>


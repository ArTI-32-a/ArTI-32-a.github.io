<style>
    body
    {
        margin: 0%;
        padding: 0%;

        background-color: #1f1e33;
    }

    article
    {
        position: relative;
        z-index: 0;
    }
    .article-enclave-up
    {
        position: absolute;
        bottom: 0;
        left: 0;
        z-index: 1500;

        width: 100%;
        height: 1145px;

        background-position: center bottom;
        background-size: contain;
        background-repeat: no-repeat;
    }
    .article-enclave-down
    {
        top: 0;
        left: 0;
        z-index: 1500;

        width: 100%;
        height: 100px;

        background-position: center top;
        background-size: contain;
        background-repeat: no-repeat;
    }
    .article-content
    {
        max-width: 100%;

        overflow: hidden;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }
    .article-background
    {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -10;

        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
    }
    .article-background-up
    {
        flex-shrink: 0;
        width: 100%;

        background-position: center top;
        background-size: 100% auto;
        background-repeat: no-repeat;
    }
    .article-background-middle
    {
        flex: 1;
        width: 100%;

        background-position: center top;
        background-size: 100% auto;
        background-repeat: repeat-y;
    }
    .article-background-down
    {
        flex-shrink: 0;
        width: 100%;

        background-position: center top;
        background-size: 100% auto;
        background-repeat: no-repeat;
    }
    .article-measurement
    {
        position: absolute;
        top: 0;
        left: 0;
        z-index: -10000;

        display: block;
        width: 100%;
        height: auto;

        opacity: 0;

        pointer-events: none;
    }


    footer
    {
        z-index: 1000;

        width: 100%;
        margin: 0;
        aspect-ratio: 16/3;

        background-position: center;
        background-size: cover;
        background-repeat: no-repeat;
    }


    .transparent
    {
        height: 50px;

        background-color: transparent;
    }

    .titleBox
    {
        position: sticky;
        top: 40%;
        z-index: 5000;

        box-sizing: border-box;
        width: fit-content;
        max-width: 800px;
        margin: 0 auto;

        padding: 10px;

        border-radius: 100px;

        background-position: top left;
        background-size: cover;
        background-repeat: no-repeat;

        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.6);

        word-wrap: break-word;
        word-break: break-word;
        overflow-wrap: break-word;
    }

    .mask
    {
        position: sticky;
        top: 0;
        z-index: 1000;

        width: 100%;
        height: 60vh;
        min-height: 10vh;
        max-height: 90vh;

        overflow: hidden;

        background-position: center 20%;
        background-size: cover;
        background-repeat: no-repeat;
        box-shadow:
            0 0 40px rgba(154, 138, 255, 1),
            0 0 80px rgba(154, 138, 255, 0.8);
    }

    .wrapper
    {
        display: grid;
        align-items: start;

        padding: 30px;

        border: 10px;

        gap: 30px;
        grid-template-columns: 250px 1fr;
    }
    .wrapper > *
    {
        min-width: 0;
    }
</style>